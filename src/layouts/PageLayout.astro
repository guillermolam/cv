---
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
import type { Lang } from '../lib/i18n';
import SectionNavRail, { type NavRailItem } from '../components/nav/SectionNavRail.astro';
import type { NavSectionId } from '../components/nav/NavSectionGlyph.astro';
import LanguageDial from '../components/i18n/LanguageDial.astro';

type Props = {
  title: string;
  description?: string;
  lang?: Lang;
  useLangPrefix?: boolean;
};

const { 
  title, 
  description, 
  lang = 'en', 
  useLangPrefix = false
} = Astro.props;
const siteName = 'Guillermo Lam Martín';
const fullTitle = `${title} · ${siteName}`;

const currentPath = Astro.url.pathname;
const prefix = useLangPrefix ? `/${lang}` : '';

const stripLangPrefix = (path: string) => {
  const match = path.match(/^\/(en|es|fr|de)(\/|$)/);
  if (!match) return path;
  return path.replace(match[0], '/');
};

const pathWithoutLang = stripLangPrefix(currentPath);

const primaryPrefix = `/${lang}`;
const nav = [
  { href: `${primaryPrefix}/`, label: 'Whoami', id: 'whoami' as const },
  { href: `${primaryPrefix}/toolchain`, label: 'Toolchain', id: 'toolchain' as const },
  { href: `${primaryPrefix}/experience`, label: 'Experience', id: 'experience' as const },
  { href: `${primaryPrefix}/blog`, label: 'Tutorials', id: 'tutorials' as const },
  { href: `${primaryPrefix}/knowledge`, label: 'Knowledge Center', id: 'knowledge' as const },
  { href: `${primaryPrefix}/contact`, label: 'Contact', id: 'contact' as const },
];

const langLinks: Array<{ code: Lang; href: string }> = [
  { code: 'en', href: `/en${pathWithoutLang}` },
  { code: 'es', href: `/es${pathWithoutLang}` },
  { code: 'fr', href: `/fr${pathWithoutLang}` },
  { code: 'de', href: `/de${pathWithoutLang}` }
];

const navRailItems: NavRailItem[] = nav.map((item) => ({
  id: item.id as NavSectionId,
  label: item.label,
  href: item.href,
  current: stripLangPrefix(item.href) === pathWithoutLang,
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {description ? <meta name="description" content={description} /> : null}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container site-header-inner">
        <a class="brand" href={`${prefix}/`}>
          <span class="brand-glyph" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 8h12l-2 8H8L6 8Z" />
              <path d="M9 8V6a3 3 0 0 1 6 0v2" />
              <circle cx="12" cy="12" r="1.2" />
            </svg>
          </span>
          <span class="brand-text">
            <span class="brand-name">{siteName}</span>
            <span class="brand-sub">Cloud Security · DevSecOps</span>
          </span>
        </a>

        <SectionNavRail items={navRailItems} label="Primary" />

        <div class="header-right">
          <span class="header-node">
            <span class="header-node-dot" aria-hidden="true"></span>
            GLM-01
          </span>
          <LanguageDial lang={lang} links={langLinks} />
        </div>
      </div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer-inner">
          <SocialLinks class="site-footer-social" />
          <p>© {new Date().getFullYear()} {siteName}. Built with Astro.</p>
        </div>
      </div>
    </footer>

    {import.meta.env.DEV ? (
      <script>
        const boot = async () => {
          const mod = await import('../scripts/devtools');
          await mod.initDevtoolsSuite();
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => void boot(), { once: true });
        } else {
          void boot();
        }
      </script>
    ) : null}
  </body>
</html>
