---
import PageLayout from './PageLayout.astro';
import type { Lang } from '../lib/i18n';

type Props = {
  title: string;
  description?: string;
  lang?: Lang;
  useLangPrefix?: boolean;
  showBackground?: boolean;
};

const { title, description, lang, useLangPrefix, showBackground } = Astro.props;
---

<PageLayout 
  title={title} 
  description={description} 
  lang={lang} 
  useLangPrefix={useLangPrefix}
  showBackground={showBackground}
>
  <slot />
</PageLayout>
