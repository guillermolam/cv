---
import { site } from '../lib/site';

type SocialKind = 'github' | 'linkedin';

type SocialLink = {
  kind: SocialKind;
  label: string;
  href: string;
};

type Props = {
  links?: SocialLink[];
  ariaLabel?: string;
  class?: string;
};

const { links = site.social, ariaLabel = 'Social links', class: className } = Astro.props;
---

<nav class:list={['social-links', className]} aria-label={ariaLabel}>
  {links.map((l) => (
    <a class="social-link" href={l.href} target="_blank" rel="noopener noreferrer">
      {l.kind === 'github' ? (
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M12 2C6.48 2 2 6.6 2 12.28c0 4.54 2.87 8.39 6.84 9.75.5.1.68-.22.68-.5 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.38-3.37-1.38-.45-1.18-1.1-1.49-1.1-1.49-.9-.64.07-.63.07-.63 1 .07 1.52 1.06 1.52 1.06.89 1.57 2.34 1.12 2.91.85.09-.67.35-1.12.63-1.38-2.22-.26-4.56-1.15-4.56-5.11 0-1.13.39-2.05 1.03-2.77-.1-.26-.45-1.31.1-2.74 0 0 .85-.28 2.8 1.06.81-.23 1.68-.34 2.55-.35.87.01 1.74.12 2.55.35 1.95-1.34 2.8-1.06 2.8-1.06.55 1.43.2 2.48.1 2.74.64.72 1.03 1.64 1.03 2.77 0 3.97-2.34 4.85-4.57 5.1.36.32.68.95.68 1.92 0 1.38-.01 2.5-.01 2.84 0 .28.18.6.69.5A10.09 10.09 0 0 0 22 12.28C22 6.6 17.52 2 12 2Z"
          />
        </svg>
      ) : (
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path
            fill="currentColor"
            d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.86-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.33V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45Z"
          />
        </svg>
      )}
      <span>{l.label}</span>
    </a>
  ))}
</nav>
