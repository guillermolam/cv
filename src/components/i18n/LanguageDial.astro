---
import type { Lang } from '../../lib/i18n';
import { SUPPORTED_LANGS } from '../../lib/i18n';
import CountryFlag from './CountryFlag.astro';

/**
 * LanguageDial — Flipper-Zero-style directional wheel for i18n selection.
 *
 * A single reusable component (replaces AnalogLanguageSelector's per-language
 * buttons). Up/Down (or Left/Right) cycle the language preview on the LCD;
 * the center SELECT button commits and navigates to that language's URL.
 *
 * No-JS fallback: every direction/Select is a real <a>; the center link points
 * at the current preview which, without JS, equals the active language — and
 * each directional link points at its neighbour, so keyboard/no-JS users can
 * still reach every language. With JS, the dial previews without navigating.
 */
export type LanguageLink = { code: Lang; href: string };

export type Props = {
  lang: Lang;
  links: readonly LanguageLink[];
  label?: string;
};

const { lang, links, label = 'Language selector' } = Astro.props as Props;

const languageMeta: Record<Lang, { name: string; region: string }> = {
  en: { name: 'English', region: 'gb' },
  es: { name: 'Español', region: 'es' },
  fr: { name: 'Français', region: 'fr' },
  de: { name: 'Deutsch', region: 'de' },
};

const hrefByCode = new Map(links.map((l) => [l.code, l.href] as const));
const orderedLangs = SUPPORTED_LANGS.filter((l) => hrefByCode.has(l));
const currentIdx = Math.max(0, orderedLangs.indexOf(lang));
const prevLang = orderedLangs[(currentIdx - 1 + orderedLangs.length) % orderedLangs.length] as Lang;
const nextLang = orderedLangs[(currentIdx + 1) % orderedLangs.length] as Lang;

// serialize the lang→href map for the client script
const linkData = JSON.stringify(
  orderedLangs.map((code) => ({ code, href: hrefByCode.get(code), name: languageMeta[code].name })),
);
---

<div
  class="lang-dial"
  aria-label={label}
  data-lang-dial
  data-current={lang}
  data-links={linkData}
>
  <div class="lang-dial-bg" data-bg-mount aria-hidden="true"></div>
  {/* ── LCD screen ─────────────────────────────────────────────────────── */}
  <div class="lang-dial-lcd" aria-hidden="true">
    <span class="lang-dial-lcd-tag">LANG</span>
    <span class="lang-dial-lcd-readout">
      {orderedLangs.map((code) => (
        <span class="lang-dial-lcd-item" data-lcd-item={code} data-active={code === lang ? 'true' : undefined}>
          <CountryFlag region={languageMeta[code].region} class="lang-dial-flag" />
          <span class="lang-dial-code">{code.toUpperCase()}</span>
          <span class="lang-dial-name">{languageMeta[code].name}</span>
        </span>
      ))}
    </span>
  </div>

  <div class="lang-dial-knob" role="group" aria-label="Language knob" data-lang-knob>
    <a
      class="lang-dial-knob-hit lang-dial-knob-hit--prev"
      href={hrefByCode.get(prevLang)}
      data-dir="prev"
      aria-label={`Previous language (${languageMeta[prevLang].name})`}
    ></a>
    <a
      class="lang-dial-knob-hit lang-dial-knob-hit--next"
      href={hrefByCode.get(nextLang)}
      data-dir="next"
      aria-label={`Next language (${languageMeta[nextLang].name})`}
    ></a>
    <button type="button" class="lang-dial-knob-core" aria-label="Rotate knob to change language" data-knob-core>
      <span class="lang-dial-knob-mark" aria-hidden="true"></span>
      <span class="lang-dial-led" aria-hidden="true"></span>
      <span class="lang-dial-knob-gloss" aria-hidden="true"></span>
    </button>
  </div>
</div>

<style>
  .lang-dial {
    display: inline-grid;
    grid-template-columns: auto auto;
    gap: 0.35rem;
    align-items: center;
    padding: 0.5rem 0.6rem;
    border-radius: 18px;
    border: 1px solid var(--fx-metal-edge, color-mix(in oklab, var(--color-border-strong), #000 30%));
    background: linear-gradient(180deg, var(--color-surface-2), var(--color-surface-3));
    box-shadow:
      0 18px 30px var(--shadow-2),
      inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%),
      inset 0 -2px 0 color-mix(in oklab, var(--color-bg), transparent 0%);
    position: relative;
    overflow: hidden;
  }

  .lang-dial-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    mix-blend-mode: overlay;
    opacity: 0.6;
  }

  .lang-dial-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 140% at 30% 0%, color-mix(in oklab, var(--color-accent), transparent 92%), transparent 60%);
  }

  /* Ensure interactive elements stay above the background */
  .lang-dial-lcd, .lang-dial-knob {
    z-index: 1;
  }

  /* ── LCD ──────────────────────────────────────────────────────────────── */
  .lang-dial-lcd {
    position: relative;
    display: grid;
    gap: 0.15rem;
    min-width: 116px;
    padding: 0.4rem 0.55rem;
    border-radius: 12px;
    border: 1px solid color-mix(in oklab, var(--color-border), transparent 6%);
    background:
      radial-gradient(120% 140% at 30% 10%, rgba(55, 214, 194, 0.16), rgba(55, 214, 194, 0.02) 60%),
      color-mix(in oklab, var(--color-bg), transparent 16%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -8px 18px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .lang-dial-lcd::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.05) 0px,
      rgba(255, 255, 255, 0.02) 1px,
      rgba(255, 255, 255, 0) 4px
    );
    opacity: 0.25;
    pointer-events: none;
    mix-blend-mode: soft-light;
  }

  .lang-dial-lcd-tag {
    font-family: var(--font-digital, var(--font-mono));
    font-size: 9px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-text-muted), var(--color-accent) 30%);
  }

  .lang-dial-lcd-readout {
    position: relative;
    display: grid;
    min-height: 1.4em;
  }

  .lang-dial-lcd-item {
    grid-area: 1 / 1;
    display: none;
    align-items: center;
    gap: 0.35rem;
  }

  .lang-dial-lcd-item[data-active='true'] {
    display: flex;
  }

  .lang-dial-flag {
    width: 1.4em;
    height: 0.95em;
    flex-shrink: 0;
  }

  .lang-dial-code {
    font-family: var(--font-digital, var(--font-mono));
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--color-text-strong);
    text-shadow: 0 0 12px rgba(55, 214, 194, 0.25);
  }

  .lang-dial-name {
    font-size: 10px;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .lang-dial-knob {
    position: relative;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    transform: rotate(var(--lang-knob-rot, 0deg));
  }

  .lang-dial-knob-core {
    width: 78px;
    height: 78px;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--color-border-strong), #000 18%);
    background:
      radial-gradient(circle at 35% 25%, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 58%),
      radial-gradient(circle at 50% 55%, color-mix(in oklab, var(--color-surface-2), #000 28%), var(--color-surface-3) 62%),
      conic-gradient(
        from 0deg,
        color-mix(in oklab, var(--color-border-strong), #000 22%),
        color-mix(in oklab, var(--color-surface-2), #000 10%),
        color-mix(in oklab, var(--color-border-strong), #000 22%)
      );
    box-shadow:
      0 18px 30px var(--shadow-2),
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      inset 0 -10px 18px rgba(0, 0, 0, 0.55);
    cursor: grab;
    text-decoration: none;
    padding: 0;
    position: relative;
    display: grid;
    place-items: center;
  }

  .lang-dial-knob-core:active {
    cursor: grabbing;
  }

  .lang-dial-knob-core::after {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 28%);
    background: radial-gradient(circle at 50% 45%, rgba(0, 0, 0, 0.0), rgba(0, 0, 0, 0.55));
    pointer-events: none;
  }

  .lang-dial-knob-mark {
    position: absolute;
    top: 7px;
    left: 50%;
    width: 6px;
    height: 6px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-accent), #fff 12%);
    box-shadow: 0 0 16px color-mix(in oklab, var(--color-accent), transparent 72%);
  }

  .lang-dial-led {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-accent), #fff 18%);
    box-shadow:
      0 0 10px color-mix(in oklab, var(--color-accent), transparent 65%),
      0 0 22px color-mix(in oklab, var(--color-accent), transparent 78%);
    opacity: 0.9;
  }

  .lang-dial-knob-gloss {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background:
      radial-gradient(100% 90% at 30% 15%, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 55%),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.05) 0px,
        rgba(255, 255, 255, 0.02) 1px,
        rgba(255, 255, 255, 0) 4px
      );
    opacity: 0.25;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .lang-dial-knob-hit {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    z-index: 2;
    text-decoration: none;
  }

  .lang-dial-knob-hit--prev {
    clip-path: polygon(0 0, 52% 0, 52% 100%, 0 100%);
  }

  .lang-dial-knob-hit--next {
    clip-path: polygon(48% 0, 100% 0, 100% 100%, 48% 100%);
  }

  .lang-dial-knob-hit:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .lang-dial-knob[data-pressed='true'] .lang-dial-knob-core {
    transform: translateY(2px);
    box-shadow:
      0 12px 18px var(--shadow-2),
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      inset 0 -10px 18px rgba(0, 0, 0, 0.65);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lang-dial-knob {
      transition: transform var(--motion-fast) var(--ease-standard);
    }

    .lang-dial-knob-core {
      transition:
        transform var(--motion-fast) var(--ease-standard),
        box-shadow var(--motion-fast) var(--ease-standard),
        border-color var(--motion-fast) var(--ease-standard);
    }

    .lang-dial-knob-core:hover {
      border-color: color-mix(in oklab, var(--color-accent), transparent 55%);
    }
    .lang-dial-lcd::after {
      animation: lang-dial-phosphor 6.4s ease-in-out infinite alternate;
    }

    .lang-dial-led {
      animation: lang-dial-led-flicker 3.6s ease-in-out infinite;
    }
  }

  @keyframes lang-dial-phosphor {
    0% { opacity: 0.18; }
    100% { opacity: 0.28; }
  }

  @keyframes lang-dial-led-flicker {
    0% { opacity: 0.75; }
    30% { opacity: 0.92; }
    62% { opacity: 0.82; }
    100% { opacity: 0.95; }
  }

  @media (max-width: 520px) {
    .lang-dial {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.4rem;
    }
  }
</style>

<script>
  import { initLanguageDials } from '../../scripts/language-dial';
  void initLanguageDials();
</script>
