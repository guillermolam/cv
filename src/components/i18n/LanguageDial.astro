---
import type { Lang } from '../../lib/i18n';
import { SUPPORTED_LANGS } from '../../lib/i18n';
import CountryFlag from './CountryFlag.astro';

/**
 * LanguageDial — Flipper-Zero-style directional wheel for i18n selection.
 *
 * A single reusable component (replaces AnalogLanguageSelector's per-language
 * buttons). Up/Down (or Left/Right) cycle the language preview on the LCD;
 * the center SELECT button commits and navigates to that language's URL.
 *
 * No-JS fallback: every direction/Select is a real <a>; the center link points
 * at the current preview which, without JS, equals the active language — and
 * each directional link points at its neighbour, so keyboard/no-JS users can
 * still reach every language. With JS, the dial previews without navigating.
 */
export type LanguageLink = { code: Lang; href: string };

export type Props = {
  lang: Lang;
  links: readonly LanguageLink[];
  label?: string;
};

const { lang, links, label = 'Language selector' } = Astro.props as Props;

const languageMeta: Record<Lang, { name: string; region: string }> = {
  en: { name: 'English', region: 'gb' },
  es: { name: 'Español', region: 'es' },
  fr: { name: 'Français', region: 'fr' },
  de: { name: 'Deutsch', region: 'de' },
};

const hrefByCode = new Map(links.map((l) => [l.code, l.href] as const));
const orderedLangs = SUPPORTED_LANGS.filter((l) => hrefByCode.has(l));
const currentIdx = Math.max(0, orderedLangs.indexOf(lang));
const prevLang = orderedLangs[
  (currentIdx - 1 + orderedLangs.length) % orderedLangs.length
] as Lang;
const nextLang = orderedLangs[(currentIdx + 1) % orderedLangs.length] as Lang;

// serialize the lang→href map for the client script
const linkData = JSON.stringify(
  orderedLangs.map((code) => ({
    code,
    href: hrefByCode.get(code),
    name: languageMeta[code].name,
  })),
);
---

<div
  class="lang-dial"
  aria-label={label}
  data-lang-dial
  data-current={lang}
  data-links={linkData}
>
  {/* ── LCD screen ─────────────────────────────────────────────────────── */}
  <div class="lang-dial-lcd" aria-hidden="true">
    <span class="lang-dial-lcd-tag">LANG</span>
    <span class="lang-dial-lcd-readout">
      {
        orderedLangs.map((code) => (
          <span
            class="lang-dial-lcd-item"
            data-lcd-item={code}
            data-active={code === lang ? 'true' : undefined}
          >
            <CountryFlag
              region={languageMeta[code].region}
              class="lang-dial-flag"
            />
            <span class="lang-dial-code">{code.toUpperCase()}</span>
            <span class="lang-dial-name">{languageMeta[code].name}</span>
          </span>
        ))
      }
    </span>
  </div>

  {/* ── D-pad wheel ────────────────────────────────────────────────────── */}
  <div class="lang-dial-pad" role="group" aria-label="Language wheel">
    <a
      class="lang-dial-btn lang-dial-btn--up"
      href={hrefByCode.get(prevLang)}
      data-dir="prev"
      aria-label={`Previous language (${languageMeta[prevLang].name})`}
    >
      <span class="ui-icon i-ph-caret-up-bold" aria-hidden="true"></span>
    </a>
    <a
      class="lang-dial-btn lang-dial-btn--left"
      href={hrefByCode.get(prevLang)}
      data-dir="prev"
      aria-label={`Previous language (${languageMeta[prevLang].name})`}
      tabindex="-1"
    >
      <span class="ui-icon i-ph-caret-left-bold" aria-hidden="true"></span>
    </a>

    <a
      class="lang-dial-btn lang-dial-btn--select"
      href={hrefByCode.get(lang)}
      data-dir="select"
      aria-label="Apply selected language"
    >
      <span class="lang-dial-select-ring" aria-hidden="true"></span>
      <span class="lang-dial-select-label">OK</span>
    </a>

    <a
      class="lang-dial-btn lang-dial-btn--right"
      href={hrefByCode.get(nextLang)}
      data-dir="next"
      aria-label={`Next language (${languageMeta[nextLang].name})`}
      tabindex="-1"
    >
      <span class="ui-icon i-ph-caret-right-bold" aria-hidden="true"></span>
    </a>
    <a
      class="lang-dial-btn lang-dial-btn--down"
      href={hrefByCode.get(nextLang)}
      data-dir="next"
      aria-label={`Next language (${languageMeta[nextLang].name})`}
    >
      <span class="ui-icon i-ph-caret-down-bold" aria-hidden="true"></span>
    </a>
  </div>
</div>

<style>
  .lang-dial {
    display: inline-grid;
    grid-template-columns: auto auto;
    gap: 0.6rem;
    align-items: center;
    padding: 0.5rem 0.6rem;
    border-radius: 18px;
    border: 1px solid
      var(
        --fx-metal-edge,
        color-mix(in oklab, var(--color-border-strong), #000 30%)
      );
    background:
      radial-gradient(
        120% 140% at 30% 0%,
        color-mix(in oklab, var(--color-accent), transparent 92%),
        transparent 60%
      ),
      linear-gradient(180deg, var(--color-surface-2), var(--color-surface-3));
    box-shadow:
      0 18px 30px var(--shadow-2),
      inset 0 1px 0
        color-mix(in oklab, var(--color-border-strong), transparent 35%),
      inset 0 -2px 0 color-mix(in oklab, var(--color-bg), transparent 0%);
  }

  /* ── LCD ──────────────────────────────────────────────────────────────── */
  .lang-dial-lcd {
    position: relative;
    display: grid;
    gap: 0.15rem;
    min-width: 116px;
    padding: 0.4rem 0.55rem;
    border-radius: 12px;
    border: 1px solid color-mix(in oklab, var(--color-border), transparent 6%);
    background:
      radial-gradient(
        120% 140% at 30% 10%,
        rgba(55, 214, 194, 0.16),
        rgba(55, 214, 194, 0.02) 60%
      ),
      color-mix(in oklab, var(--color-bg), transparent 16%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -8px 18px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .lang-dial-lcd::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.05) 0px,
      rgba(255, 255, 255, 0.02) 1px,
      rgba(255, 255, 255, 0) 4px
    );
    opacity: 0.25;
    pointer-events: none;
    mix-blend-mode: soft-light;
  }

  .lang-dial-lcd-tag {
    font-family: var(--font-digital, var(--font-mono));
    font-size: 9px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: color-mix(
      in oklab,
      var(--color-text-muted),
      var(--color-accent) 30%
    );
  }

  .lang-dial-lcd-readout {
    position: relative;
    display: grid;
    min-height: 1.4em;
  }

  .lang-dial-lcd-item {
    grid-area: 1 / 1;
    display: none;
    align-items: center;
    gap: 0.35rem;
  }

  .lang-dial-lcd-item[data-active='true'] {
    display: flex;
  }

  .lang-dial-flag {
    width: 1.4em;
    height: 0.95em;
    flex-shrink: 0;
  }

  .lang-dial-code {
    font-family: var(--font-digital, var(--font-mono));
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--color-text-strong);
    text-shadow: 0 0 12px rgba(55, 214, 194, 0.25);
  }

  .lang-dial-name {
    font-size: 10px;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* ── D-pad ────────────────────────────────────────────────────────────── */
  .lang-dial-pad {
    position: relative;
    width: 78px;
    height: 78px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(3, 1fr);
    place-items: center;
  }

  .lang-dial-btn {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    border: 1px solid
      color-mix(in oklab, var(--color-border-strong), transparent 10%);
    background: linear-gradient(
      180deg,
      var(--color-surface-2),
      var(--color-surface-3)
    );
    color: var(--color-text-muted);
    text-decoration: none;
    box-shadow:
      0 4px 0 color-mix(in oklab, var(--color-bg), #000 30%),
      inset 0 1px 0
        color-mix(in oklab, var(--color-border-strong), transparent 25%);
    transform: translateZ(0);
  }

  .lang-dial-btn .ui-icon {
    font-size: 14px;
  }

  .lang-dial-btn--up {
    grid-area: 1 / 2;
  }
  .lang-dial-btn--left {
    grid-area: 2 / 1;
  }
  .lang-dial-btn--right {
    grid-area: 2 / 3;
  }
  .lang-dial-btn--down {
    grid-area: 3 / 2;
  }

  .lang-dial-btn--select {
    grid-area: 2 / 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--color-text-strong);
    background:
      radial-gradient(
        circle at 38% 30%,
        color-mix(in oklab, #fff, transparent 80%),
        transparent 55%
      ),
      linear-gradient(
        180deg,
        var(--color-accent),
        color-mix(in oklab, var(--color-accent), #000 35%)
      );
    border-color: color-mix(in oklab, var(--color-accent), #000 30%);
    box-shadow:
      0 5px 0 color-mix(in oklab, var(--color-accent), #000 55%),
      inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }

  .lang-dial-select-label {
    font-family: var(--font-techno, var(--font-display));
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-bg);
  }

  .lang-dial-select-ring {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--color-accent), transparent 60%);
    pointer-events: none;
  }

  .lang-dial-btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  /* pressed / active state (set by JS or :active) */
  .lang-dial-btn:active,
  .lang-dial-btn[data-pressed='true'] {
    transform: translateY(3px);
    box-shadow:
      0 1px 0 color-mix(in oklab, var(--color-bg), #000 30%),
      inset 0 2px 6px rgba(0, 0, 0, 0.5);
  }

  @media (prefers-reduced-motion: no-preference) {
    .lang-dial-btn {
      transition:
        transform var(--motion-fast) var(--ease-standard),
        box-shadow var(--motion-fast) var(--ease-standard),
        border-color var(--motion-fast) var(--ease-standard);
    }
    .lang-dial-btn:hover {
      border-color: color-mix(in oklab, var(--color-accent), transparent 55%);
      color: var(--color-text-strong);
    }
    .lang-dial-lcd::after {
      animation: lang-dial-phosphor 6.4s ease-in-out infinite alternate;
    }
  }

  @keyframes lang-dial-phosphor {
    0% {
      opacity: 0.18;
    }
    100% {
      opacity: 0.28;
    }
  }

  @media (max-width: 520px) {
    .lang-dial {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.4rem;
    }
  }
</style>

<script>
  import { initLanguageDials } from '../../scripts/language-dial';
  void initLanguageDials();
</script>
