---
type Props = {
  eyebrow?: string;
  headline: string;
  subheadline: string;
};

const { eyebrow, headline, subheadline } = Astro.props;
---

<div class="fallback-hero">
  <svg
    class="fallback-topology"
    viewBox="0 0 1200 520"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id="grad-a" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--accent-6)" stop-opacity="0.22" />
        <stop offset="1" stop-color="var(--neutral-9)" stop-opacity="0.06" />
      </linearGradient>
      <radialGradient id="grad-b" cx="30%" cy="20%" r="70%">
        <stop offset="0" stop-color="var(--accent-6)" stop-opacity="0.16" />
        <stop offset="1" stop-color="var(--neutral-0)" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect x="0" y="0" width="1200" height="520" fill="url(#grad-b)" />
    <g opacity="0.55" stroke="var(--color-border)" stroke-width="1">
      <path d="M140 380 L320 260 L520 300 L680 180 L860 220 L1030 120" fill="none" />
      <path d="M180 160 L360 240 L540 120 L720 240 L900 150 L1080 260" fill="none" />
      <path d="M120 280 L320 360 L520 220 L680 340 L860 300 L1060 380" fill="none" />
    </g>
    <g fill="var(--neutral-9)" opacity="0.25">
      <circle cx="140" cy="380" r="6" />
      <circle cx="320" cy="260" r="5" />
      <circle cx="520" cy="300" r="6" />
      <circle cx="680" cy="180" r="5" />
      <circle cx="860" cy="220" r="6" />
      <circle cx="1030" cy="120" r="5" />

      <circle cx="180" cy="160" r="5" />
      <circle cx="360" cy="240" r="6" />
      <circle cx="540" cy="120" r="5" />
      <circle cx="720" cy="240" r="6" />
      <circle cx="900" cy="150" r="5" />
      <circle cx="1080" cy="260" r="6" />
    </g>
    <rect
      x="60"
      y="60"
      width="1080"
      height="400"
      rx="18"
      fill="url(#grad-a)"
      opacity="0.22"
      stroke="var(--color-border)"
    />
  </svg>

  <div class="fallback-hero-content">
    {eyebrow ? <p class="hero-eyebrow">{eyebrow}</p> : null}
    <h1 class="hero-title">{headline}</h1>
    <p class="hero-subtitle">{subheadline}</p>
    <slot />
  </div>
</div>

