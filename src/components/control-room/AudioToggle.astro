---
/**
 * AudioToggle — mute/unmute control wired to the $audioMuted nanostore.
 *
 * Renders an accessible toggle button. Icon + state are updated client-side by
 * subscribing to the store, so it reflects the persisted choice on load.
 */
export type Props = {
  class?: string;
};
const { class: className } = Astro.props as Props;
---

<button
  type="button"
  class:list={['audio-toggle', className]}
  data-audio-toggle
  aria-pressed="false"
  aria-label="Toggle control room audio"
  title="Toggle audio"
>
  <span class="audio-toggle-icon i-solar-muted-bold-duotone" aria-hidden="true"></span>
  <span class="audio-toggle-label" aria-hidden="true">SFX</span>
</button>

<style>
  .audio-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 30px;
    padding: 0 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-surface-2), transparent 12%);
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .audio-toggle:hover {
    border-color: color-mix(in oklab, var(--color-accent), transparent 55%);
    color: var(--color-text-strong);
  }

  .audio-toggle:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .audio-toggle-icon {
    font-size: 1rem;
  }

  .audio-toggle[aria-pressed='true'] {
    border-color: color-mix(in oklab, var(--color-accent), transparent 40%);
    color: var(--color-text-strong);
  }

  .audio-toggle-label {
    font-family: var(--font-techno, var(--font-display));
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>

<script>
  import { initAudioEngine } from '../../lib/audio/sfx';
  import { $audioMuted, toggleAudio } from '../../stores/control-room';
  import { emitSfx } from '../../lib/audio/events';

  initAudioEngine();

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-audio-toggle]');

  const sync = (muted: boolean) => {
    buttons.forEach((btn) => {
      btn.setAttribute('aria-pressed', String(!muted));
      const icon = btn.querySelector('.audio-toggle-icon');
      if (icon) {
        icon.classList.toggle('i-solar-muted-bold-duotone', muted);
        icon.classList.toggle('i-solar-volume-loud-bold-duotone', !muted);
      }
    });
  };

  $audioMuted.subscribe(sync);

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      toggleAudio();
      if (!$audioMuted.get()) emitSfx('click');
    });
  });
</script>
