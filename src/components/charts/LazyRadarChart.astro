---
/**
 * LazyRadarChart — reusable radar chart that hydrates Just-In-Time.
 *
 * Pattern proof for the project: the Chart.js bundle is dynamically imported
 * ONLY when the chart scrolls into view (IntersectionObserver). The instance is
 * owned by this component and destroyed on teardown. An accessible <table>
 * fallback is always present (canvas is never the only source of the data).
 */
export type RadarRow = { label: string; score: number | null; confidence?: string };

export type Props = {
  rows: readonly RadarRow[];
  title?: string;
  class?: string;
};

const { rows, title = 'Operator radar', class: className } = Astro.props as Props;

const labels = JSON.stringify(rows.map((r) => r.label));
const scores = JSON.stringify(rows.map((r) => r.score ?? 0));
---

<div class:list={['lazy-radar', className]} data-lazy-radar data-labels={labels} data-scores={scores}>
  {/* Accessible fallback — always present */}
  <table class="sr-only" aria-label={`${title} data`}>
    <thead>
      <tr>
        <th scope="col">Domain</th>
        <th scope="col">Score</th>
        {rows.some((r) => r.confidence) && <th scope="col">Confidence</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.label}</th>
          <td>{r.score === null ? 'N/A' : `${r.score}/100`}</td>
          {rows.some((x) => x.confidence) && (
            <td style="text-transform: capitalize">{r.confidence ?? '—'}</td>
          )}
        </tr>
      ))}
    </tbody>
  </table>

  {/* Canvas — progressive enhancement, hydrated on scroll */}
  <canvas class="lazy-radar-canvas" data-lazy-radar-canvas width="280" height="280" aria-hidden="true"></canvas>
</div>

<style>
  .lazy-radar {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .lazy-radar-canvas {
    width: 100%;
    max-width: 240px;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    background: radial-gradient(
      circle at 35% 25%,
      color-mix(in oklab, var(--color-cta), transparent 86%),
      color-mix(in oklab, var(--color-surface-3), transparent 4%)
    );
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { initLazyRadars } from '../../scripts/lazy-radar';
  void initLazyRadars();
</script>
