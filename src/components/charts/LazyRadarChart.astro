---
/**
 * LazyRadarChart — radar chart hydrated Just-In-Time on scroll.
 *
 * Visual design notes:
 *  - Canvas fills its CSS parent via width:100%/height:100% and
 *    maintainAspectRatio:false in the Chart.js options (lazy-radar.ts).
 *    Callers control size by setting a height on the wrapper or via class.
 *  - No border on the canvas itself — the parent panel provides the frame.
 *  - Accent colour is inherited from --color-cta (same token as the whole site).
 */
export type RadarRow = { label: string; score: number | null; confidence?: string };

export type Props = {
  rows: readonly RadarRow[];
  title?: string;
  class?: string;
};

const { rows, title = 'Skill radar', class: className } = Astro.props as Props;

const labels = JSON.stringify(rows.map((r) => r.label));
const scores = JSON.stringify(rows.map((r) => r.score ?? null));
---

<div
  class:list={['lazy-radar', className]}
  data-lazy-radar
  data-labels={labels}
  data-scores={scores}
>
  {/* Accessible fallback — always present, visually hidden */}
  <table class="sr-only" aria-label={`${title} data`}>
    <thead>
      <tr>
        <th scope="col">Domain</th>
        <th scope="col">Score</th>
        {rows.some((r) => r.confidence) && <th scope="col">Level</th>}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <th scope="row">{r.label}</th>
          <td>{r.score === null ? 'N/A' : `${r.score}/100`}</td>
          {rows.some((x) => x.confidence) && (
            <td style="text-transform:capitalize">{r.confidence ?? '—'}</td>
          )}
        </tr>
      ))}
    </tbody>
  </table>

  {/* Canvas — progressive enhancement; fills .lazy-radar via CSS below */}
  <canvas
    class="lazy-radar-canvas"
    data-lazy-radar-canvas
    aria-hidden="true"
  ></canvas>
</div>

<style>
  .lazy-radar {
    position: relative;
    width: 100%;
    /* Default height — caller can override with a class or inline style */
    height: 260px;
  }

  .lazy-radar-canvas {
    /* Fill the container so Chart.js can use maintainAspectRatio:false */
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  import { initLazyRadars } from '../../scripts/lazy-radar';
  void initLazyRadars();
</script>
