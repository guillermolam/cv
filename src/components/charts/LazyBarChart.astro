---
/**
 * LazyBarChart — reusable bar chart that hydrates Just-In-Time.
 *
 * Chart.js loads only when the element scrolls into view (or an Alpine x-show
 * section is revealed). Instance owned here, destroyed on teardown. An
 * accessible <table> fallback is always present.
 */
export type Props = {
  labels: readonly string[];
  values: readonly number[];
  title?: string;
  series?: string;
  horizontal?: boolean;
  max?: number;
  height?: number;
  class?: string;
};

const {
  labels,
  values,
  title = 'Chart',
  series = 'Value',
  horizontal = false,
  max,
  height = 220,
  class: className,
} = Astro.props as Props;

const labelsJson = JSON.stringify(labels);
const valuesJson = JSON.stringify(values);
---

<div
  class:list={['lazy-bar', className]}
  data-lazy-bar
  data-labels={labelsJson}
  data-values={valuesJson}
  data-series={series}
  data-horizontal={horizontal ? 'true' : 'false'}
  data-max={max !== undefined ? String(max) : undefined}
>
  <table class="sr-only" aria-label={`${title} data`}>
    <thead>
      <tr><th scope="col">Label</th><th scope="col">{series}</th></tr>
    </thead>
    <tbody>
      {labels.map((label, i) => (
        <tr><th scope="row">{label}</th><td>{values[i] ?? 0}</td></tr>
      ))}
    </tbody>
  </table>

  <div class="lazy-bar-stage" style={`height:${height}px`}>
    <canvas data-lazy-bar-canvas aria-hidden="true"></canvas>
  </div>
</div>

<style>
  .lazy-bar { position: relative; }
  .lazy-bar-stage { position: relative; width: 100%; }
  .lazy-bar-stage canvas { width: 100% !important; height: 100% !important; }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }
</style>

<script>
  import { initLazyBars } from '../../scripts/lazy-bar';
  void initLazyBars();
</script>
