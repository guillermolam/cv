---
export type Props = {
  class?: string;
};

const { class: className } = Astro.props as Props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  data-whoami-status-glyph
>
  <path
    d="M12 2.8c4.9 0 8.9 4 8.9 8.9S16.9 20.6 12 20.6 3.1 16.6 3.1 11.7 7.1 2.8 12 2.8Z"
    fill="none"
    stroke="var(--color-border-strong)"
    stroke-width="1.2"
    opacity="0.65"
  />
  <path
    d="M12 6.4v5.6l3.6 2.2"
    fill="none"
    stroke="var(--color-accent)"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    opacity="0.85"
  />
  <circle cx="12" cy="12" r="1.5" fill="var(--color-accent)" opacity="0.7" />
</svg>

