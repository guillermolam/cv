---
import type { WhoamiAxisResult } from '../../lib/content/whoami-stats';
import CircuitTraceSvg from './CircuitTraceSvg.astro';
import LazyRadarChart from '../charts/LazyRadarChart.astro';
import LazyBarChart from '../charts/LazyBarChart.astro';
import CountryFlag from '../i18n/CountryFlag.astro';

export type SectionData = {
  skills: { name: string; categories: string[] }[];
  certifications: { name: string; issuer: string; status: string }[];
  education: { degree: string; institution: string; field?: string }[];
  languages: { name: string; level: string; flagRegion: string; pct: number }[];
  experience: { company: string; role: string; start: string; end: string }[];
};

export type Props = {
  axes: WhoamiAxisResult[];
  sections: SectionData;
};

const { axes, sections } = Astro.props as Props;

// Icon per axis label — Phosphor duotone
const iconMap: Record<string, string> = {
  cloud:        'i-solar-cloud-bold-duotone',
  security:     'i-solar-shield-check-bold-duotone',
  devsecops:    'i-solar-code-circle-bold-duotone',
  kubernetes:   'i-solar-box-bold-duotone',
  architecture: 'i-solar-structure-bold-duotone',
  leadership:   'i-solar-users-group-rounded-bold-duotone',
  automation:   'i-solar-settings-bold-duotone',
  ai:           'i-solar-atom-bold-duotone',
};

const confidenceDot: Record<string, { color: string; label: string }> = {
  high:   { color: 'var(--color-success)',  label: 'High'   },
  medium: { color: 'var(--color-warning)',  label: 'Medium' },
  low:    { color: 'var(--color-danger)',   label: 'Low'    },
};

const getIcon = (label: string) =>
  iconMap[label.toLowerCase().replace(/[^a-z]/g, '')] ?? 'i-solar-chart-2-bold-duotone';

// Skills aggregated by category → bar chart data (Chart.js, lazy).
const skillCatCounts = new Map<string, number>();
for (const s of sections.skills) {
  for (const c of s.categories) skillCatCounts.set(c, (skillCatCounts.get(c) ?? 0) + 1);
}
const skillBarLabels = [...skillCatCounts.keys()];
const skillBarValues = [...skillCatCounts.values()];

// Languages → proficiency bar chart data.
const langBarLabels = sections.languages.map((l) => l.name);
const langBarValues = sections.languages.map((l) => l.pct);

---

<section
  class="whoami-stats card pad"
  aria-label="Operator stats"
  x-data="whoamiStats()"
>
  <CircuitTraceSvg id="stats-trace" class="whoami-stats-trace" />

  <!-- Header — title reflects the active keyboard section ───────────────── -->
  <header class="whoami-stats-header">
    <p class="whoami-stats-eyebrow">
      <span class="ui-icon i-solar-target-bold-duotone" aria-hidden="true"></span>
      Core profile
    </p>
    <h2 class="whoami-stats-title" x-text="title()">Operator stats</h2>
  </header>

  {/* ════════ BIO view (default) — radar + competency bars ════════ */}
  <div class="core-view" x-show="is('bio')">
    {/* Radar chart — prominent, top */}
    <div class="stat-radar-wrap">
      <LazyRadarChart
        rows={axes.map((axis) => ({
          label: axis.label,
          score: axis.score,
          confidence: axis.confidence,
        }))}
        title="Operator radar"
      />
    </div>

    <ul class="stat-list" role="list" aria-label="Competency index">
      {axes.map((axis) => {
        const icon = getIcon(axis.label);
        const dot  = confidenceDot[axis.confidence] ?? confidenceDot['low']!;
        const pct  = axis.score ?? 0;
        const rowId = `stat-${axis.label.toLowerCase().replace(/\s+/g, '-')}`;
        return (
          <li class="stat-row" data-axis-id={rowId}>
            <button
              class="stat-row-btn"
              type="button"
              aria-expanded="false"
              aria-controls={`${rowId}-evidence`}
              x-on:click={`toggle('${rowId}')`}
              x-bind:aria-expanded={`isOpen('${rowId}').toString()`}
            >
              <span class={`stat-icon ui-icon ${icon}`} aria-hidden="true"></span>
              <span class="stat-label">{axis.label}</span>
              <span class="stat-track" aria-hidden="true">
                <span class="stat-fill" style={`--pct: ${pct}%`}></span>
              </span>
              <span class="stat-score">{axis.score === null ? 'N/A' : `${axis.score}`}</span>
              <span class="stat-confidence" style={`--dot-color: ${dot.color}`} aria-label={`Confidence: ${dot.label}`}></span>
              <span class="stat-chevron ui-icon i-ph-caret-right" aria-hidden="true" x-bind:class={`{ 'stat-chevron-open': isOpen('${rowId}') }`}></span>
            </button>

            <div
              id={`${rowId}-evidence`}
              class="stat-evidence"
              x-show={`isOpen('${rowId}')`}
              x-transition:enter="stat-evidence-enter"
              x-transition:enter-start="stat-evidence-enter-start"
              x-transition:enter-end="stat-evidence-enter-end"
              x-transition:leave="stat-evidence-leave"
              x-transition:leave-start="stat-evidence-leave-start"
              x-transition:leave-end="stat-evidence-leave-end"
            >
              <p class="stat-evidence-summary">{axis.evidenceSummary}</p>
              {axis.evidenceSources.length > 0 && (
                <ul class="stat-evidence-sources">
                  {axis.evidenceSources.map((s) => (
                    <li><span class="ui-icon i-solar-link-circle-bold-duotone" aria-hidden="true"></span>{s}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        );
      })}
    </ul>

    <p class="stat-footnote">
      <span class="ui-icon i-solar-info-circle-bold-duotone" aria-hidden="true"></span>
      Scores are a portfolio evidence index — not ratings.
    </p>
  </div>

  {/* ════════ SKILLS — skills-per-category bar chart (Chart.js) + list ════════ */}
  <div class="core-view" x-show="is('skills')" style="display:none">
    {sections.skills.length === 0 ? (
      <p class="core-empty">No skills modeled yet.</p>
    ) : (
      <>
        {skillBarLabels.length > 0 && (
          <LazyBarChart
            labels={skillBarLabels}
            values={skillBarValues}
            series="Skills"
            title="Skills by category"
            horizontal
            height={Math.max(140, skillBarLabels.length * 30)}
          />
        )}
        <ul class="core-list" role="list">
          {sections.skills.map((s) => (
            <li class="core-item">
              <span class="core-item-icon ui-icon i-solar-cpu-bold-duotone" aria-hidden="true"></span>
              <span class="core-item-name">{s.name}</span>
              {s.categories.length > 0 && (
                <span class="core-pills">{s.categories.map((c) => <span class="core-pill">{c}</span>)}</span>
              )}
            </li>
          ))}
        </ul>
      </>
    )}
  </div>

  {/* ════════ CERTIFICATIONS ════════ */}
  <div class="core-view" x-show="is('certifications')" style="display:none">
    {sections.certifications.length === 0 ? (
      <p class="core-empty">No certifications modeled yet.</p>
    ) : (
      <ul class="core-list" role="list">
        {sections.certifications.map((c) => (
          <li class="core-item">
            <span class="core-item-icon ui-icon i-solar-diploma-verified-bold-duotone" aria-hidden="true"></span>
            <span class="core-item-name">{c.name}</span>
            <span class="core-item-meta">{c.issuer} · {c.status}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  {/* ════════ EDUCATION ════════ */}
  <div class="core-view" x-show="is('education')" style="display:none">
    {sections.education.length === 0 ? (
      <p class="core-empty">No education modeled yet.</p>
    ) : (
      <ul class="core-list" role="list">
        {sections.education.map((e) => (
          <li class="core-item">
            <span class="core-item-icon ui-icon i-solar-square-academic-cap-bold-duotone" aria-hidden="true"></span>
            <span class="core-item-name">{e.degree}</span>
            <span class="core-item-meta">{e.institution}{e.field ? ` · ${e.field}` : ''}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  {/* ════════ LANGUAGES — proficiency chart (Chart.js) + flag bars ════════ */}
  <div class="core-view" x-show="is('languages')" style="display:none">
    {sections.languages.length === 0 ? (
      <p class="core-empty">No languages modeled yet.</p>
    ) : (
      <>
      <LazyBarChart
        labels={langBarLabels}
        values={langBarValues}
        series="Proficiency"
        title="Language proficiency"
        horizontal
        max={100}
        height={Math.max(140, langBarLabels.length * 34)}
      />
      <ul class="core-bars" role="list">
        {sections.languages.map((l) => (
          <li class="core-bar-row">
            <CountryFlag region={l.flagRegion} class="core-bar-flag" />
            <span class="core-bar-label">{l.name}</span>
            <span class="core-bar-track" aria-hidden="true">
              <span class="core-bar-fill" style={`--pct: ${l.pct}%`}></span>
            </span>
            <span class="core-bar-val">{l.level}</span>
          </li>
        ))}
      </ul>
      </>
    )}
  </div>

  {/* ════════ EXPERIENCE — timeline ════════ */}
  <div class="core-view" x-show="is('experience')" style="display:none">
    {sections.experience.length === 0 ? (
      <p class="core-empty">No experience modeled yet.</p>
    ) : (
      <ul class="core-timeline" role="list">
        {sections.experience.map((e) => (
          <li class="core-tl-item">
            <span class="core-tl-dot" aria-hidden="true"></span>
            <div class="core-tl-body">
              <p class="core-tl-role">{e.role}</p>
              <p class="core-tl-meta">{e.company} · {e.start}{e.end ? ` — ${e.end}` : ''}</p>
            </div>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .whoami-stats {
    position: relative;
    overflow: hidden;
    background: color-mix(in oklab, var(--color-surface-2), transparent 14%);
    border-color: color-mix(in oklab, var(--color-border), transparent 5%);
    box-shadow:
      0 18px 44px var(--shadow-2),
      inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%),
      inset 0 -2px 0 color-mix(in oklab, var(--color-bg), transparent 0%);
    display: grid;
    gap: 1rem;
  }

  .whoami-stats::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.03) 0px,
        rgba(255, 255, 255, 0.012) 1px,
        rgba(255, 255, 255, 0) 4px
      ),
      radial-gradient(
        120% 140% at 20% 0%,
        color-mix(in oklab, var(--color-accent), transparent 92%),
        transparent 56%
      );
    opacity: 0.18;
    pointer-events: none;
    mix-blend-mode: soft-light;
  }

  :global(.whoami-stats-trace) {
    position: absolute;
    inset: -24px;
    pointer-events: none;
    opacity: 0.22;
    filter: blur(0.2px);
  }

  /* ── Header ─────────────────────────────────────────────────────────── */
  .whoami-stats-header {
    display: grid;
    gap: 0.2rem;
    position: relative;
    z-index: 1;
  }

  .whoami-stats-eyebrow {
    margin: 0;
    font-size: var(--font-size-0);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .whoami-stats-eyebrow .ui-icon {
    font-size: 1rem;
    color: var(--color-cta);
    opacity: 0.8;
  }

  .whoami-stats-title {
    margin: 0;
    font-size: var(--font-size-4);
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  /* ── Stat list ──────────────────────────────────────────────────────── */
  .stat-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1px;
    position: relative;
    z-index: 1;
  }

  .stat-row {
    border-radius: 10px;
    overflow: hidden;
  }

  .stat-row-btn {
    width: 100%;
    display: grid;
    grid-template-columns: 1.2rem 1fr 100px 2.2rem 0.8rem 0.8rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.52rem 0.6rem;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text);
    border-radius: 10px;
    transition:
      background var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .stat-row-btn:hover,
  .stat-row-btn:focus-visible {
    background: color-mix(in oklab, var(--color-surface-3), transparent 45%);
  }

  .stat-row-btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: -1px;
  }

  .stat-icon {
    font-size: 1rem;
    color: var(--color-cta);
    opacity: 0.85;
    flex-shrink: 0;
  }

  .stat-label {
    font-size: var(--font-size-0);
    font-weight: 500;
    text-align: left;
    color: var(--color-text-strong);
    white-space: nowrap;
  }

  /* ── Score bar ──────────────────────────────────────────────────────── */
  .stat-track {
    height: 4px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-border), transparent 18%);
    overflow: hidden;
    display: block;
  }

  .stat-fill {
    display: block;
    height: 100%;
    width: var(--pct, 0%);
    border-radius: 999px;
    background: linear-gradient(
      to right,
      var(--color-cta),
      color-mix(in oklab, var(--color-cta), var(--color-link-hover) 45%)
    );
    transition: width 0.9s var(--ease-emphasis);
  }

  .stat-score {
    font-size: var(--font-size-0);
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    text-align: right;
    justify-self: end;
    line-height: 1;
  }

  .stat-confidence {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--dot-color, var(--color-text-muted));
    flex-shrink: 0;
  }

  .stat-chevron {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .stat-chevron-open {
    transform: rotate(90deg);
  }

  /* ── Evidence drawer ────────────────────────────────────────────────── */
  .stat-evidence {
    padding: 0.5rem 0.6rem 0.6rem 2.2rem;
    border-top: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-bg), transparent 28%);
  }

  .stat-evidence-enter { transition: all 0.22s var(--ease-standard); }
  .stat-evidence-enter-start { opacity: 0; transform: translateY(-4px); }
  .stat-evidence-enter-end   { opacity: 1; transform: translateY(0); }
  .stat-evidence-leave { transition: all 0.16s var(--ease-standard); }
  .stat-evidence-leave-start { opacity: 1; transform: translateY(0); }
  .stat-evidence-leave-end   { opacity: 0; transform: translateY(-4px); }

  .stat-evidence-summary {
    margin: 0 0 0.4rem 0;
    font-size: var(--font-size-0);
    color: var(--color-text-muted);
  }

  .stat-evidence-sources {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.2rem;
    font-size: var(--font-size-00);
    color: var(--color-text-muted);
  }

  .stat-evidence-sources li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .stat-evidence-sources .ui-icon {
    font-size: 0.85rem;
    color: var(--color-cta);
    opacity: 0.6;
    flex-shrink: 0;
  }

  /* ── Radar canvas ───────────────────────────────────────────────────── */
  /* ── Switchable section views ────────────────────────────────────────── */
  .core-view {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.85rem;
  }

  .core-empty {
    margin: 0;
    padding: 1.5rem 0.5rem;
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--font-size-0);
  }

  .core-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .core-item {
    display: grid;
    grid-template-columns: 1.1rem 1fr auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.6rem;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-surface-3), transparent 45%);
  }

  .core-item-icon {
    font-size: 1rem;
    color: var(--color-cta);
    opacity: 0.85;
  }

  .core-item-name {
    font-size: var(--font-size-0);
    font-weight: 500;
    color: var(--color-text-strong);
  }

  .core-item-meta {
    font-size: var(--font-size-00);
    color: var(--color-text-muted);
    text-transform: capitalize;
  }

  .core-pills {
    grid-column: 2 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.1rem;
  }

  .core-pill {
    font-size: var(--font-size-00);
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  /* Language bars */
  .core-bars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .core-bar-row {
    display: grid;
    grid-template-columns: 1.5rem 5.5rem 1fr 2.4rem;
    align-items: center;
    gap: 0.5rem;
  }

  .core-bar-flag {
    width: 1.5rem;
    height: 1rem;
  }

  .core-bar-label {
    font-size: var(--font-size-0);
    color: var(--color-text-strong);
  }

  .core-bar-track {
    height: 6px;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-border), transparent 18%);
    overflow: hidden;
  }

  .core-bar-fill {
    display: block;
    height: 100%;
    width: var(--pct, 0%);
    border-radius: 999px;
    background: linear-gradient(to right, var(--color-cta), color-mix(in oklab, var(--color-cta), var(--color-link-hover) 45%));
    transition: width 0.9s var(--ease-emphasis);
  }

  .core-bar-val {
    font-family: var(--font-digital, var(--font-mono));
    font-size: var(--font-size-0);
    color: var(--color-text-muted);
    text-align: right;
  }

  /* Experience timeline */
  .core-timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.5rem;
    display: grid;
    gap: 0.7rem;
  }

  .core-tl-item {
    display: grid;
    grid-template-columns: 0.8rem 1fr;
    gap: 0.6rem;
    align-items: start;
    position: relative;
  }

  .core-tl-dot {
    width: 9px;
    height: 9px;
    margin-top: 0.3rem;
    border-radius: 50%;
    background: var(--color-cta);
    box-shadow: 0 0 8px var(--fx-glow-accent);
  }

  .core-tl-role {
    margin: 0;
    font-size: var(--font-size-0);
    font-weight: 600;
    color: var(--color-text-strong);
  }

  .core-tl-meta {
    margin: 0.1rem 0 0;
    font-size: var(--font-size-00);
    color: var(--color-text-muted);
  }

  .stat-radar-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
  }

  .stat-radar-canvas {
    width: 100%;
    max-width: 240px;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--color-border);
    background: radial-gradient(
      circle at 35% 25%,
      color-mix(in oklab, var(--color-cta), transparent 86%),
      color-mix(in oklab, var(--color-surface-3), transparent 4%)
    );
  }

  /* ── Footnote ────────────────────────────────────────────────────────── */
  .stat-footnote {
    margin: 0;
    font-size: var(--font-size-00);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    position: relative;
    z-index: 1;
    opacity: 0.72;
  }

  .stat-footnote .ui-icon {
    font-size: 0.9rem;
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  /* ── A11y ────────────────────────────────────────────────────────────── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
