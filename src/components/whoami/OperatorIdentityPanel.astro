---
import BadgeRack from './BadgeRack.astro';
import CircuitTraceSvg from './CircuitTraceSvg.astro';
import Avatar3D from '../Avatar3D.astro';
import SocialLinks from '../SocialLinks.astro';
import UiGrid from '../layout/UiGrid.astro';
import UiStack from '../layout/UiStack.astro';
import OperatorModuleNav from './OperatorModuleNav.astro';

export type Badge = { label: string; domainId?: string };

export type Props = {
  name: string;
  role?: string;
  focus?: string;
  locationMode: string;
  availability: string;
  nationality: string;
  dob: string;
  birthPlace: string;
  zodiac: string;
  height: string;
  weight: string;
  badges: Badge[];
};

const {
  name,
  role,
  focus,
  locationMode,
  availability,
  nationality,
  dob,
  birthPlace,
  badges,
} = Astro.props as Props;

const sectionItems = [
  { id: 'bio', label: 'Bio', iconHref: '/images/svg/id-card-svgrepo-com.svg' },
  { id: 'skills', label: 'Skills', iconHref: '/images/svg/chart-line-svgrepo-com.svg' },
  { id: 'certifications', label: 'Certs', iconHref: '/images/svg/thumb-up-svgrepo-com.svg' },
  { id: 'education', label: 'Education', iconHref: '/images/svg/building-svgrepo-com.svg' },
  { id: 'languages', label: 'Languages', iconHref: '/images/svg/globe-1-svgrepo-com.svg' },
  { id: 'experience', label: 'Experience', iconHref: '/images/svg/briefcase-svgrepo-com.svg' },
] as const;

type BioField = { icon: string; label: string; value: string; variant?: 'status' };
const bioFields: BioField[] = [
  role ? { icon: 'i-solar-briefcase-bold-duotone', label: 'Role', value: role } : null,
  focus ? { icon: 'i-solar-target-bold-duotone', label: 'Focus', value: focus } : null,
  { icon: 'i-solar-map-point-bold-duotone', label: 'Location', value: locationMode },
  { icon: 'i-solar-letter-bold-duotone', label: 'Status', value: availability, variant: 'status' as const },
  { icon: 'i-solar-flag-bold-duotone', label: 'Nationality', value: nationality },
  { icon: 'i-solar-calendar-date-bold-duotone', label: 'Born', value: dob },
  { icon: 'i-solar-map-point-bold-duotone', label: 'Origin', value: birthPlace },
].filter((f): f is BioField => f !== null);
---

<section class="op-identity card pad" aria-label="Operator identity">

  <!-- Header: identity + status + social -->
  <header class="op-header">
    <div class="op-header-left">
      <p class="op-eyebrow">
        <span class="ui-icon i-solar-programming-bold-duotone" aria-hidden="true"></span>
        Operator identity
      </p>
      <h1 class="op-name">{name}</h1>
      {role && <p class="op-role">{role}</p>}
    </div>
    <div class="op-header-right">
      <span class="op-status-chip">
        <span class="op-status-dot" aria-hidden="true"></span>
        {availability}
      </span>
      <SocialLinks ariaLabel="Operator links" />
    </div>
  </header>

  <!-- Body: portrait + module nav + badges | bio details -->
  <UiGrid class="op-body" minItemWidth="320px" gap="1rem" align="start">

    <UiStack class="op-left" aria-label="Operator modules" gap="0.75rem">
      <div class="op-portrait-frame" aria-label={`Avatar of ${name}`}>
        <CircuitTraceSvg id="op-portrait-trace" class="op-portrait-trace" />
        <Avatar3D size="lg" ariaLabel={`3D avatar of ${name}`} />
        <div class="op-portrait-edge" aria-hidden="false">
          <div class="op-portrait-edge-left">
            <div class="op-portrait-chip" role="img" aria-label="Nationality: Spain">
              <svg class="op-flag" viewBox="0 0 24 16" aria-hidden="true" focusable="false">
                <rect x="0" y="0" width="24" height="16" rx="3" fill="#aa151b" />
                <rect x="0" y="4" width="24" height="8" fill="#f1bf00" />
              </svg>
              <span class="op-chip-label">ES</span>
            </div>
            <div class="op-portrait-chip" role="img" aria-label="Region: Community of Madrid">
              <svg class="op-flag" viewBox="0 0 24 16" aria-hidden="true" focusable="false">
                <defs>
                  <clipPath id="flag-clip-mad">
                    <rect x="0" y="0" width="24" height="16" rx="3"></rect>
                  </clipPath>
                </defs>
                <g clip-path="url(#flag-clip-mad)">
                  <rect x="0" y="0" width="24" height="16" fill="#c60b1e" />
                  <g fill="#fff" transform="translate(0 0) scale(1.2)">
                    <polygon points="0,-1 0.224,-0.309 0.951,-0.309 0.363,0.118 0.588,0.809 0,0.382 -0.588,0.809 -0.363,0.118 -0.951,-0.309 -0.224,-0.309" transform="translate(5.8 5.1)"></polygon>
                    <polygon points="0,-1 0.224,-0.309 0.951,-0.309 0.363,0.118 0.588,0.809 0,0.382 -0.588,0.809 -0.363,0.118 -0.951,-0.309 -0.224,-0.309" transform="translate(9.2 5.1)"></polygon>
                    <polygon points="0,-1 0.224,-0.309 0.951,-0.309 0.363,0.118 0.588,0.809 0,0.382 -0.588,0.809 -0.363,0.118 -0.951,-0.309 -0.224,-0.309" transform="translate(12.6 5.1)"></polygon>
                    <polygon points="0,-1 0.224,-0.309 0.951,-0.309 0.363,0.118 0.588,0.809 0,0.382 -0.588,0.809 -0.363,0.118 -0.951,-0.309 -0.224,-0.309" transform="translate(16.0 5.1)"></polygon>
                    <polygon points="0,-1 0.224,-0.309 0.951,-0.309 0.363,0.118 0.588,0.809 0,0.382 -0.588,0.809 -0.363,0.118 -0.951,-0.309 -0.224,-0.309" transform="translate(7.5 8.8)"></polygon>
                    <polygon points="0,-1 0.224,-0.309 0.951,-0.309 0.363,0.118 0.588,0.809 0,0.382 -0.588,0.809 -0.363,0.118 -0.951,-0.309 -0.224,-0.309" transform="translate(10.9 8.8)"></polygon>
                    <polygon points="0,-1 0.224,-0.309 0.951,-0.309 0.363,0.118 0.588,0.809 0,0.382 -0.588,0.809 -0.363,0.118 -0.951,-0.309 -0.224,-0.309" transform="translate(14.3 8.8)"></polygon>
                  </g>
                </g>
              </svg>
              <span class="op-chip-label">MAD</span>
            </div>
          </div>
          <div class="op-portrait-chip" role="img" aria-label="Gender: male">
            <span class="op-gender-symbol" aria-hidden="true">♂</span>
          </div>
        </div>
      </div>

      <OperatorModuleNav items={sectionItems} />

      <BadgeRack label="Specializations" badges={badges} />
    </UiStack>

    <!-- Bio details — compact data table -->
    <div class="op-right" aria-label="Operator details">
      <div class="op-bio-panel">
        <header class="op-bio-header">
          <span class="i-solar-document-text-bold-duotone op-bio-header-icon" aria-hidden="true"></span>
          <div>
            <h2 class="op-bio-title">Operator Data</h2>
            <p class="op-bio-sub">{bioFields.length} fields · verified</p>
          </div>
        </header>

        <dl class="op-details">
          {bioFields.map((f) => (
            <div class:list={['op-detail-row', f.variant === 'status' && 'op-detail-row--status']}>
              <dt class="op-detail-term">
                <span class={`ui-icon ${f.icon}`} aria-hidden="true"></span>
                {f.label}
              </dt>
              <dd class="op-detail-value">
                {f.variant === 'status' && <span class="op-detail-status-dot" aria-hidden="true"></span>}
                {f.value}
              </dd>
            </div>
          ))}
        </dl>

        <p class="op-bio-footnote">
          <span class="i-solar-info-circle-bold-duotone op-bio-footnote-icon" aria-hidden="true"></span>
          Data sourced from CV · content graph
        </p>
      </div>
    </div>
  </UiGrid>
</section>

<style>
  /* ── Outer card ──────────────────────────────────────────────────── */
  .op-identity {
    grid-area: center;
    display: grid;
    gap: 1rem;
    min-width: 0;
    background: color-mix(in oklab, var(--color-surface-2), transparent 14%);
    border-color: color-mix(in oklab, var(--color-border), transparent 5%);
    box-shadow:
      0 18px 44px var(--shadow-2),
      inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%),
      inset 0 -2px 0 color-mix(in oklab, var(--color-bg), transparent 0%);
  }

  /* ── Header ──────────────────────────────────────────────────────── */
  .op-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .op-header-left {
    display: grid;
    gap: 0.15rem;
  }

  .op-eyebrow {
    margin: 0;
    font-size: var(--font-size-0);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .op-eyebrow .ui-icon {
    font-size: 1rem;
    color: var(--color-cta);
    opacity: 0.75;
  }

  .op-name {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, var(--font-size-6));
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--color-text-strong);
  }

  .op-role {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-0);
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .op-header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .op-status-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-success), transparent 55%);
    background: color-mix(in oklab, var(--color-success), transparent 88%);
    font-family: var(--font-mono);
    font-size: var(--font-size-00);
    letter-spacing: 0.04em;
    color: var(--color-success);
    white-space: nowrap;
  }

  .op-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 8px var(--color-success);
  }

  .op-header-right :global(.social-links) {
    margin-top: 0;
    justify-content: flex-end;
  }

  /* ── Body ────────────────────────────────────────────────────────── */
  .op-body { min-width: 0; }
  .op-left { min-width: 0; }
  .op-right { min-width: 0; }

  /* ── Portrait frame ──────────────────────────────────────────────── */
  .op-portrait-frame {
    display: grid;
    place-items: center;
    padding: 0.9rem;
    border-radius: 22px;
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 18%);
    position: relative;
    background:
      radial-gradient(90% 110% at 50% 5%, color-mix(in oklab, var(--color-accent), transparent 86%), transparent 55%),
      color-mix(in oklab, var(--color-surface-2), transparent 4%);
    box-shadow:
      0 22px 44px var(--shadow-2),
      inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%);
    overflow: visible;
  }

  .op-portrait-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: repeating-linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 0px, rgba(255, 255, 255, 0.02) 1px, rgba(255, 255, 255, 0) 3px);
    opacity: 0.25;
    pointer-events: none;
    mix-blend-mode: soft-light;
  }

  :global(.op-portrait-trace) {
    position: absolute;
    inset: -18px;
    opacity: 0.35;
    pointer-events: none;
    filter: blur(0.2px);
  }

  .op-portrait-edge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -14px;
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0 0.65rem;
    pointer-events: none;
    z-index: 3;
  }

  .op-portrait-edge-left {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
  }

  .op-portrait-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.45rem;
    border-radius: 12px;
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 18%);
    background: color-mix(in oklab, var(--color-surface-2), transparent 8%);
    box-shadow:
      0 14px 24px var(--shadow-2),
      inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%);
  }

  .op-gender-symbol {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: color-mix(in oklab, var(--color-text-strong), var(--color-accent) 18%);
    text-shadow: 0 0 12px color-mix(in oklab, var(--color-accent), transparent 75%);
    line-height: 1;
  }

  .op-flag {
    width: 22px;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 8px 14px var(--shadow-2), inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .op-chip-label {
    font-family: var(--font-mono);
    font-size: var(--font-size-00);
    letter-spacing: 0.08em;
    color: var(--color-text-strong);
  }

  /* ── Bio panel ───────────────────────────────────────────────────── */
  .op-bio-panel {
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: color-mix(in oklab, var(--color-surface-2), transparent 14%);
    box-shadow: 0 8px 24px var(--shadow-2);
    padding: 0.85rem 1rem;
    display: grid;
    gap: 0.65rem;
  }

  .op-bio-header {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--color-border);
  }

  .op-bio-header-icon {
    font-size: 1.4rem;
    color: var(--color-cta);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .op-bio-title {
    margin: 0 0 1px;
    font-family: var(--font-mono);
    font-size: var(--font-size-1);
    font-weight: 600;
    color: var(--color-text-strong);
  }

  .op-bio-sub {
    margin: 0;
    font-size: var(--font-size-00);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  /* ── Detail rows ─────────────────────────────────────────────────── */
  .op-details {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    min-width: 0;
  }

  .op-detail-row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.38rem 0.5rem;
    border-radius: 8px;
    transition: background 0.15s ease;
  }

  .op-detail-row:hover {
    background: color-mix(in oklab, var(--color-surface-3), transparent 45%);
  }

  .op-detail-row--status {
    background: color-mix(in oklab, var(--color-success), transparent 92%);
  }

  .op-detail-term {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--font-size-00);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .op-detail-term .ui-icon {
    font-size: 0.85rem;
    color: var(--color-cta);
    opacity: 0.7;
    flex-shrink: 0;
  }

  .op-detail-value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--font-size-0);
    color: var(--color-text-strong);
    letter-spacing: 0.01em;
    text-align: right;
    min-width: 0;
    word-break: break-word;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .op-detail-status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 6px var(--color-success);
    flex-shrink: 0;
  }

  .op-bio-footnote {
    margin: 0;
    padding-top: 0.4rem;
    border-top: 1px solid var(--color-border);
    font-size: var(--font-size-00);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    opacity: 0.65;
  }

  .op-bio-footnote-icon {
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  /* ── Responsive ──────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .op-name { font-size: var(--font-size-5); }
    .op-header { flex-direction: column; gap: 0.5rem; }
    .op-header-right { align-items: flex-start; }
    .op-detail-row { grid-template-columns: 6rem 1fr; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .op-status-dot {
      animation: op-led 2.4s ease-in-out infinite;
    }
  }

  @keyframes op-led {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
</style>
