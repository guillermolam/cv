---
export type Props = {
  id?: string;
  class?: string;
  enabled?: boolean;
};

const { id = 'op-frame', class: className, enabled = false } = Astro.props as Props;
const uid = id.replace(/[^a-zA-Z0-9\-_]/g, '');
---

{
  enabled && (
    <svg
      class={className}
      viewBox="0 0 1000 560"
      preserveAspectRatio="none"
      aria-hidden="true"
      focusable="false"
      data-whoami-frame
    >
      <defs>
        <linearGradient id={`${uid}-edge`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="var(--color-border-strong)" stop-opacity="0.92" />
          <stop offset="1" stop-color="var(--color-border)" stop-opacity="0.45" />
        </linearGradient>
        <linearGradient id={`${uid}-glow`} x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="var(--color-accent)" stop-opacity="0.14" />
          <stop offset="1" stop-color="var(--color-accent)" stop-opacity="0.02" />
        </linearGradient>
      </defs>

      <rect x="2" y="2" width="996" height="556" rx="26" fill="none" stroke={`url(#${uid}-edge)`} stroke-width="1.5" />
      <rect x="10" y="10" width="980" height="540" rx="22" fill="none" stroke="var(--color-border)" stroke-opacity="0.6" stroke-width="1" />

      <path
        d="M22 74 L22 34 L62 34 M938 34 L978 34 L978 74 M22 486 L22 526 L62 526 M938 526 L978 526 L978 486"
        fill="none"
        stroke={`url(#${uid}-glow)`}
        stroke-width="2"
        stroke-linecap="round"
      />

      <path
        d="M40 106 L190 106 M810 106 L960 106 M40 454 L210 454 M790 454 L960 454"
        fill="none"
        stroke="var(--color-border)"
        stroke-opacity="0.55"
        stroke-width="1"
        stroke-linecap="round"
      />

      <g opacity="0.7">
        <circle cx="44" cy="44" r="3" fill="var(--color-border-strong)" />
        <circle cx="956" cy="44" r="3" fill="var(--color-border-strong)" />
        <circle cx="44" cy="516" r="3" fill="var(--color-border-strong)" />
        <circle cx="956" cy="516" r="3" fill="var(--color-border-strong)" />
      </g>
    </svg>
  )
}
