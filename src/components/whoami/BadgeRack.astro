---
export type Badge = {
  label: string;
  detail?: string;
  domainId?: string;
};

export type Props = {
  label?: string;
  badges: Badge[];
};

const { label = 'Specializations', badges } = Astro.props as Props;

const domainIcon: Record<string, string> = {
  'cloud-security': 'i-solar-shield-check-bold-duotone',
  'devsecops': 'i-solar-code-circle-bold-duotone',
  'kubernetes-platform': 'i-solar-box-bold-duotone',
  'platform-engineering': 'i-solar-server-bold-duotone',
  'ai-security': 'i-solar-atom-bold-duotone',
  'supply-chain-security': 'i-solar-lock-bold-duotone',
};

const domainAccent: Record<string, string> = {
  'cloud-security': 'var(--ds-color-security, var(--color-cta))',
  'devsecops': 'var(--ds-color-automation, var(--color-cta))',
  'kubernetes-platform': 'var(--ds-color-infra, var(--color-cta))',
  'platform-engineering': 'var(--ds-color-cloud, var(--color-cta))',
  'ai-security': 'var(--color-warning)',
  'supply-chain-security': 'var(--ds-color-compliance, var(--color-cta))',
};

const getIcon = (id?: string) => (id && domainIcon[id]) || 'i-solar-verified-check-bold-duotone';
const getAccent = (id?: string) => (id && domainAccent[id]) || 'var(--color-cta)';
---

<section class="badge-rack" aria-label={label}>
  <h2 class="badge-rack__title">
    <span class="i-solar-medal-ribbons-star-bold-duotone badge-rack__title-icon" aria-hidden="true"></span>
    {label}
  </h2>
  {badges.length === 0 ? (
    <p class="badge-rack__empty">Badges appear as evidence is added to the content graph.</p>
  ) : (
    <div class="badge-rack__grid" role="list" data-badge-carousel>
      {badges.map((b, i) => {
        const icon = getIcon(b.domainId);
        const accent = getAccent(b.domainId);
        return (
          <div
            class="badge-card"
            role="listitem"
            style={`--badge-accent: ${accent}; --badge-index: ${i}`}
            data-badge-card
            data-badge-carousel-item
          >
            <span class={`badge-card__icon ${icon}`} aria-hidden="true"></span>
            <span class="badge-card__label">{b.label}</span>
            <span class="badge-card__indicator" aria-hidden="true"></span>
          </div>
        );
      })}
    </div>
  )}
</section>

<style>
  .badge-rack {
    display: grid;
    gap: 0.6rem;
  }

  .badge-rack__title {
    margin: 0;
    font-size: var(--font-size-0);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }

  .badge-rack__title-icon {
    font-size: 1rem;
    color: var(--color-cta);
    opacity: 0.8;
  }

  .badge-rack__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 0.45rem;
  }

  .badge-rack__grid.badge-rack__grid--carousel {
    --badge-carousel-size: clamp(156px, 22vw, 210px);

    display: block;
    position: relative;
    height: calc(var(--badge-carousel-size) + 108px);
    perspective: clamp(900px, 120vw, 1400px);
    perspective-origin: 50% 42%;
    transform-style: preserve-3d;
    transform: rotateX(-9deg);
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .badge-rack__grid.badge-rack__grid--carousel:active {
    cursor: grabbing;
  }

  .badge-rack__grid.badge-rack__grid--carousel::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 62%;
    width: calc(var(--badge-carousel-size) * 3.4);
    height: calc(var(--badge-carousel-size) * 3.4);
    transform: translate(-50%, -50%) rotateX(90deg);
    background: radial-gradient(
      circle at 50% 45%,
      color-mix(in oklab, var(--color-cta), transparent 88%),
      transparent 65%
    );
    opacity: 0.35;
    filter: blur(1px);
    pointer-events: none;
  }

  .badge-rack__grid.badge-rack__grid--carousel .badge-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: var(--badge-carousel-size);
    aspect-ratio: 1 / 1;
    transform: translate3d(-50%, -50%, 0);
    justify-content: center;
    flex-direction: column;
    text-align: center;
    gap: 0.65rem;
    border-radius: 18px;
    padding: 0.9rem;
    will-change: transform, opacity, filter;
    backface-visibility: hidden;
    transform-style: preserve-3d;
    user-select: none;
    box-shadow:
      0 calc(10px * var(--depth, 0.5)) calc(34px * var(--depth, 0.5))
        color-mix(in oklab, #000, transparent 55%),
      inset 0 1px 0 color-mix(in oklab, #fff, transparent 88%);
  }

  .badge-rack__grid.badge-rack__grid--carousel .badge-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      color-mix(in oklab, #fff, transparent 92%),
      transparent 45%,
      color-mix(in oklab, var(--badge-accent), transparent 92%)
    );
    opacity: calc(0.06 + var(--depth, 0.5) * 0.12);
    pointer-events: none;
  }

  .badge-card {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.65rem;
    border-radius: 10px;
    border: 1px solid color-mix(in oklab, var(--badge-accent), transparent 65%);
    background:
      radial-gradient(
        120% 140% at 10% 0%,
        color-mix(in oklab, var(--badge-accent), transparent 88%),
        transparent 55%
      ),
      color-mix(in oklab, var(--color-surface-3), transparent 35%);
    position: relative;
    overflow: hidden;
  }

  .badge-card__icon {
    font-size: 1.1rem;
    color: var(--badge-accent);
    flex-shrink: 0;
    opacity: 0.9;
  }

  .badge-rack__grid.badge-rack__grid--carousel .badge-card__icon {
    font-size: 2rem;
  }

  .badge-rack__grid.badge-rack__grid--carousel .badge-card__label {
    font-size: var(--font-size-0);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-strong);
  }

  .badge-card__label {
    font-family: var(--font-mono);
    font-size: var(--font-size-00);
    font-weight: 500;
    color: var(--color-text-strong);
    letter-spacing: 0.01em;
    line-height: 1.2;
  }

  .badge-card__indicator {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--badge-accent);
    margin-left: auto;
    flex-shrink: 0;
    opacity: 0.6;
    box-shadow: 0 0 6px color-mix(in oklab, var(--badge-accent), transparent 60%);
  }

  .badge-rack__empty {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-0);
    font-family: var(--font-mono);
  }

  @media (prefers-reduced-motion: no-preference) {
    .badge-card {
      transition:
        border-color 0.2s ease,
        transform 0.2s ease,
        box-shadow 0.2s ease;
    }

    .badge-card:hover {
      border-color: color-mix(in oklab, var(--badge-accent), transparent 35%);
      transform: translateY(-1px);
      box-shadow: 0 4px 14px color-mix(in oklab, var(--badge-accent), transparent 80%);
    }

    .badge-card__indicator {
      animation: badge-pulse 2.8s ease-in-out infinite;
      animation-delay: calc(var(--badge-index, 0) * 0.4s);
    }
  }

  @keyframes badge-pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }
</style>
