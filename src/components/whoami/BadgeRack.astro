---
export type Badge = {
  label: string;
  detail?: string;
  imageIndex?: number;
  domainId?: string;
};

export type Props = {
  label?: string;
  badges: Badge[];
};

const { label = 'Specializations', badges } = Astro.props as Props;

const domainBadgeIndex: Record<string, number> = {
  'cloud-security': 1,
  devsecops: 2,
  'kubernetes-platform': 3,
  'platform-engineering': 4,
  'ai-security': 5,
  'supply-chain-security': 6,
};

const getBadgeIndex = (badge: Badge, index: number) =>
  badge.imageIndex ?? (badge.domainId ? domainBadgeIndex[badge.domainId] : undefined) ?? (index % 15) + 1;

const badgeVariants = ['code', 'layers', 'flow', 'cube', 'devops', 'shield'] as const;
const getBadgeVariant = (badge: Badge, index: number) => badgeVariants[(getBadgeIndex(badge, index) - 1) % badgeVariants.length];
const paletteVariants = ['cyan', 'emerald', 'amber', 'violet', 'steel', 'rose'] as const;
const getBadgePalette = (badge: Badge, index: number) => paletteVariants[(getBadgeIndex(badge, index) - 1) % paletteVariants.length];

const carouselId = `badge-gallery-${Math.random().toString(36).slice(2)}`;
---

<section class="whoami-badges" aria-label={label}>
  <h2 class="whoami-badges-title">{label}</h2>
  {badges.length === 0 ? (
    <p class="whoami-badges-empty">Badges will appear as more evidence is added to the content graph.</p>
  ) : (
    <div class="whoami-badge-gallery" data-badge-gallery data-active-index="0" id={carouselId}>
      <div class="whoami-badge-stage" aria-live="polite">
        {badges.map((badge, index) => (
          <article
            class:list={['whoami-badge-slide', index === 0 && 'is-active']}
            data-badge-slide
            data-index={index}
            aria-label={badge.detail ? `${badge.label}: ${badge.detail}` : badge.label}
          >
            <div class="whoami-badge-art" aria-hidden="true">
              <span class="whoami-badge-orbit"></span>
              <span class="whoami-badge-reflection"></span>
              <svg
                class="whoami-badge-image"
                data-variant={getBadgeVariant(badge, index)}
                data-palette={getBadgePalette(badge, index)}
                viewBox="0 0 160 180"
                role="img"
                aria-hidden="true"
                focusable="false"
              >
                <defs>
                  <linearGradient id={`${carouselId}-metal-${index}`} x1="20" y1="12" x2="138" y2="168" gradientUnits="userSpaceOnUse">
                    <stop offset="0" stop-color="var(--badge-metal-a)" />
                    <stop offset="0.26" stop-color="var(--badge-metal-b)" />
                    <stop offset="0.48" stop-color="#fff7e6" />
                    <stop offset="0.72" stop-color="var(--badge-metal-c)" />
                    <stop offset="1" stop-color="var(--badge-metal-a)" />
                  </linearGradient>
                  <linearGradient id={`${carouselId}-cyan-${index}`} x1="24" y1="24" x2="132" y2="144" gradientUnits="userSpaceOnUse">
                    <stop offset="0" stop-color="var(--badge-accent-a)" />
                    <stop offset="0.52" stop-color="var(--badge-accent-b)" />
                    <stop offset="1" stop-color="var(--badge-accent-c)" />
                  </linearGradient>
                  <radialGradient id={`${carouselId}-glass-${index}`} cx="50%" cy="24%" r="78%">
                    <stop offset="0" stop-color="#ffffff" stop-opacity="0.18" />
                    <stop offset="0.42" stop-color="#071014" stop-opacity="0.72" />
                    <stop offset="1" stop-color="#020609" stop-opacity="0.98" />
                  </radialGradient>
                  <pattern id={`${carouselId}-texture-${index}`} width="10" height="10" patternUnits="userSpaceOnUse">
                    <path d="M0 10 10 0M-2 2 2-2M8 12 12 8" stroke="currentColor" stroke-opacity="0.13" stroke-width="0.6" />
                    <circle cx="2" cy="7" r="0.6" fill="currentColor" fill-opacity="0.22" />
                  </pattern>
                  <filter id={`${carouselId}-glow-${index}`} x="-30%" y="-30%" width="160%" height="160%">
                    <feGaussianBlur stdDeviation="2.4" result="blur" />
                    <feMerge>
                      <feMergeNode in="blur" />
                      <feMergeNode in="SourceGraphic" />
                    </feMerge>
                  </filter>
                </defs>

                <polygon class="badge-shell badge-shell--floor" points="80 18 144 55 144 128 80 180 16 128 16 55" />
                <path class="badge-shell badge-shell--side badge-shell--side-left" d="M16 43 28 49v63l-12 6Z" />
                <path class="badge-shell badge-shell--side badge-shell--side-right" d="M144 43 132 49v63l12 6Z" />
                <path class="badge-shell badge-shell--side badge-shell--side-bottom" d="M16 118 28 112l52 46 52-46 12 6-64 56Z" />
                <polygon class="badge-shell badge-shell--shadow" points="80 8 142 44 142 116 80 172 18 116 18 44" />
                <polygon class="badge-shell badge-shell--metal" points="80 6 144 43 144 118 80 174 16 118 16 43" fill={`url(#${carouselId}-metal-${index})`} />
                <polygon class="badge-shell badge-shell--inner" points="80 18 132 49 132 112 80 158 28 112 28 49" fill={`url(#${carouselId}-glass-${index})`} />
                <polygon class="badge-texture" points="80 20 129 51 129 110 80 154 31 110 31 51" fill={`url(#${carouselId}-texture-${index})`} />
                <polygon class="badge-shell badge-shell--rim" points="80 26 122 52 122 108 80 146 38 108 38 52" />
                <g class="badge-circuit" stroke={`url(#${carouselId}-cyan-${index})`} filter={`url(#${carouselId}-glow-${index})`}>
                  <path d="M80 24v14M80 142v14M32 80h14M114 80h14" />
                  <path d="M55 43h-14v18M105 43h14v18M55 118h-14v-18M105 118h14v-18" />
                  <circle cx="80" cy="38" r="2.3" /><circle cx="80" cy="142" r="2.3" />
                  <circle cx="46" cy="80" r="2.3" /><circle cx="114" cy="80" r="2.3" />
                </g>

                <g class="badge-icon badge-icon--code" stroke={`url(#${carouselId}-cyan-${index})`}>
                  <path d="M68 65 50 82l18 17M92 65l18 17-18 17M84 58 75 106" />
                </g>
                <g class="badge-icon badge-icon--layers" stroke={`url(#${carouselId}-cyan-${index})`}>
                  <path d="M80 54 112 72 80 90 48 72 80 54Z" fill="rgba(57,219,230,.28)" />
                  <path d="M52 91 80 107 108 91M58 111 80 124 102 111" />
                </g>
                <g class="badge-icon badge-icon--flow" stroke={`url(#${carouselId}-cyan-${index})`}>
                  <rect x="68" y="50" width="24" height="18" rx="3" />
                  <rect x="48" y="96" width="24" height="18" rx="3" stroke="#f0a33a" />
                  <rect x="88" y="96" width="24" height="18" rx="3" stroke="#f0a33a" />
                  <path d="M80 68v15M60 96V83h40v13" />
                </g>
                <g class="badge-icon badge-icon--cube" stroke={`url(#${carouselId}-cyan-${index})`}>
                  <path d="M80 50 108 66v32l-28 18-28-18V66l28-16Z" />
                  <path d="M52 66 80 82l28-16M80 82v34" />
                  <path d="M66 59 94 75M94 59 66 75" opacity=".56" />
                </g>
                <g class="badge-icon badge-icon--devops" stroke={`url(#${carouselId}-cyan-${index})`}>
                  <path d="M65 73c8-18 39-15 39 8 0 23-31 26-48 8-17-18 5-45 29-32" />
                  <path d="M95 88c-8 18-39 15-39-8 0-23 31-26 48-8 17 18-5 45-29 32" />
                </g>
                <g class="badge-icon badge-icon--shield" stroke={`url(#${carouselId}-cyan-${index})`}>
                  <path d="M80 48 112 60v25c0 25-16 39-32 47-16-8-32-22-32-47V60l32-12Z" />
                  <rect x="68" y="82" width="24" height="24" rx="4" />
                  <path d="M73 82v-8a7 7 0 0 1 14 0v8" />
                </g>

                <path class="badge-glint" d="M42 42c22-18 55-21 83-5" />
                <path class="badge-scanline" d="M30 128 130 52" />
              </svg>
              <span class="whoami-badge-sheen"></span>
            </div>
            <div class="whoami-badge-copy">
              <p class="whoami-badge-kicker">Specialization {String(index + 1).padStart(2, '0')}</p>
              <h3>{badge.label}</h3>
              {badge.detail && <p data-badge-detail data-text={badge.detail}>{badge.detail}</p>}
            </div>
          </article>
        ))}
      </div>

      <div class="whoami-badge-controls" aria-label={`${label} carousel controls`}>
        <button class="whoami-badge-nav" type="button" data-badge-prev aria-label="Previous badge">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="whoami-badge-progress" aria-label={label}>
          {badges.map((badge, index) => (
            <button
              class:list={['whoami-badge-dot', index === 0 && 'is-active']}
              type="button"
              aria-label={`Show ${badge.label}`}
              aria-current={index === 0 ? 'true' : 'false'}
              data-badge-dot
              data-index={index}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
            </button>
          ))}
        </div>
        <button class="whoami-badge-nav" type="button" data-badge-next aria-label="Next badge">
          <span aria-hidden="true">›</span>
        </button>
      </div>
    </div>
  )}
</section>

<script>
  (() => {
    const galleries = document.querySelectorAll('[data-badge-gallery]');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    galleries.forEach((gallery) => {
      const slides = Array.from(gallery.querySelectorAll('[data-badge-slide]'));
      const dots = Array.from(gallery.querySelectorAll('[data-badge-dot]'));
      const prev = gallery.querySelector('[data-badge-prev]');
      const next = gallery.querySelector('[data-badge-next]');
      const count = slides.length;
      let activeIndex = 0;
      let timer: number | undefined;

      if (count <= 1) return;

      const setActive = (nextIndex: number) => {
        activeIndex = (nextIndex + count) % count;
        gallery.setAttribute('data-active-index', String(activeIndex));

        slides.forEach((slide, index) => {
          const isActive = index === activeIndex;
          slide.classList.toggle('is-active', isActive);
          slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });

        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-current', isActive ? 'true' : 'false');
        });

        gallery.dispatchEvent(new CustomEvent('badge-gallery:change', { detail: { index: activeIndex } }));
      };

      const stop = () => {
        if (timer) window.clearInterval(timer);
        timer = undefined;
      };

      const start = () => {
        if (prefersReduced || timer) return;
        timer = window.setInterval(() => setActive(activeIndex + 1), 5600);
      };

      prev?.addEventListener('click', () => {
        stop();
        setActive(activeIndex - 1);
        start();
      });

      next?.addEventListener('click', () => {
        stop();
        setActive(activeIndex + 1);
        start();
      });

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          stop();
          setActive(index);
          start();
        });
      });

      gallery.addEventListener('pointerenter', stop);
      gallery.addEventListener('pointerleave', start);
      gallery.addEventListener('focusin', stop);
      gallery.addEventListener('focusout', start);

      setActive(0);
      start();
    });
  })();
</script>

<style>
  .whoami-badges-title {
    margin: 0 0 0.8rem;
    font-size: var(--font-size-0);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    opacity: 0.8;
  }

  .whoami-badge-gallery {
    display: grid;
    gap: 0.75rem;
    min-width: 0;
  }

  .whoami-badge-stage {
    position: relative;
    min-height: 188px;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 10%);
    border-radius: 20px;
    background:
      radial-gradient(circle at 50% 24%, color-mix(in oklab, var(--color-accent), transparent 72%), transparent 36%),
      radial-gradient(circle at 78% 8%, rgba(255, 255, 255, 0.2), transparent 28%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.08), transparent 34%),
      linear-gradient(155deg, color-mix(in oklab, var(--color-surface-2), black 4%), color-mix(in oklab, var(--color-surface-3), black 8%));
    box-shadow:
      0 18px 42px var(--shadow-2),
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      inset 0 -1px 0 color-mix(in oklab, #000, transparent 58%);
    perspective: 620px;
  }

  .whoami-badge-stage::before {
    content: '';
    position: absolute;
    inset: 12%;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-accent), transparent 84%);
    filter: blur(42px);
    opacity: 0.65;
    pointer-events: none;
  }

  .whoami-badge-stage::after {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: inherit;
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.22), transparent 18%, transparent 72%, rgba(255, 255, 255, 0.08)),
      linear-gradient(180deg, transparent 58%, rgba(0, 0, 0, 0.22));
    opacity: 0.38;
    pointer-events: none;
  }

  .whoami-badge-slide {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 0.58rem;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(22px, 0, -80px) rotateY(-14deg) scale(0.94);
    transition:
      opacity 720ms var(--ease-standard),
      visibility 720ms var(--ease-standard),
      transform 720ms var(--ease-standard);
  }

  .whoami-badge-slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: translate3d(0, 0, 0) rotateY(0deg) scale(1);
    z-index: 2;
  }

  .whoami-badge-art {
    position: relative;
    display: grid;
    place-items: center;
    width: min(90%, 178px);
    aspect-ratio: 1;
    transform-style: preserve-3d;
    z-index: 1;
  }

  .whoami-badge-art::before {
    content: '';
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: 2%;
    height: 16%;
    border-radius: 999px;
    background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.42), transparent 72%);
    transform: translateZ(-30px) rotateX(72deg);
    opacity: 0.72;
  }

  .whoami-badge-orbit {
    position: absolute;
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid color-mix(in oklab, var(--color-accent), transparent 48%);
    border-radius: 999px;
    background:
      conic-gradient(from 210deg, transparent, color-mix(in oklab, var(--color-accent), white 12%), transparent 34%, transparent 74%, rgba(255, 255, 255, 0.24), transparent),
      radial-gradient(circle, transparent 58%, rgba(255, 255, 255, 0.08) 59%, transparent 62%);
    box-shadow:
      0 0 30px color-mix(in oklab, var(--color-accent), transparent 66%),
      inset 0 0 28px color-mix(in oklab, var(--color-accent), transparent 78%);
    transform: rotateX(62deg) translateZ(-12px);
  }

  .whoami-badge-image {
    --badge-accent-a: #bcffff;
    --badge-accent-b: #38dbe6;
    --badge-accent-c: #0c7e91;
    --badge-metal-a: #f8f5ec;
    --badge-metal-b: #8f8678;
    --badge-metal-c: #645b50;
    color: var(--badge-accent-b);
    width: min(96%, 160px);
    height: auto;
    overflow: visible;
    backface-visibility: hidden;
    transform: translate3d(0, -4px, 48px) rotateX(10deg) rotateY(-18deg) rotateZ(-1deg);
    transform-style: preserve-3d;
    filter:
      drop-shadow(0 20px 24px color-mix(in oklab, #000, transparent 50%))
      drop-shadow(0 0 18px color-mix(in oklab, var(--color-accent), transparent 66%))
      saturate(1.02);
    shape-rendering: geometricPrecision;
    text-rendering: geometricPrecision;
  }

  .whoami-badge-image[data-palette="emerald"] {
    --badge-accent-a: #caffd8;
    --badge-accent-b: #49e88b;
    --badge-accent-c: #0c7b4d;
    --badge-metal-a: #eff7df;
    --badge-metal-b: #7f927b;
    --badge-metal-c: #3f5c4b;
  }

  .whoami-badge-image[data-palette="amber"] {
    --badge-accent-a: #ffe8a8;
    --badge-accent-b: #f5a93b;
    --badge-accent-c: #8d4a14;
    --badge-metal-a: #fff2d2;
    --badge-metal-b: #a7804b;
    --badge-metal-c: #604224;
  }

  .whoami-badge-image[data-palette="violet"] {
    --badge-accent-a: #f0d2ff;
    --badge-accent-b: #b57cff;
    --badge-accent-c: #5b2fa0;
    --badge-metal-a: #f7efff;
    --badge-metal-b: #8d7ca3;
    --badge-metal-c: #51445f;
  }

  .whoami-badge-image[data-palette="steel"] {
    --badge-accent-a: #e8f2ff;
    --badge-accent-b: #7fb5ff;
    --badge-accent-c: #315c8f;
    --badge-metal-a: #f3f7fb;
    --badge-metal-b: #8391a0;
    --badge-metal-c: #48525d;
  }

  .whoami-badge-image[data-palette="rose"] {
    --badge-accent-a: #ffd6df;
    --badge-accent-b: #ff708f;
    --badge-accent-c: #9c2c48;
    --badge-metal-a: #fff0f3;
    --badge-metal-b: #a97983;
    --badge-metal-c: #60404a;
  }

  .badge-shell--shadow {
    fill: rgba(0, 0, 0, 0.36);
    transform: translateY(4px);
  }

  .badge-shell--floor {
    fill: color-mix(in oklab, var(--badge-metal-c), black 28%);
    filter: blur(0.2px);
  }

  .badge-shell--side {
    stroke: rgba(255, 255, 255, 0.18);
    stroke-width: 0.8;
  }

  .badge-shell--side-left {
    fill: color-mix(in oklab, var(--badge-metal-c), black 34%);
  }

  .badge-shell--side-right {
    fill: color-mix(in oklab, var(--badge-metal-b), black 18%);
  }

  .badge-shell--side-bottom {
    fill: color-mix(in oklab, var(--badge-metal-c), black 45%);
  }

  .badge-shell--metal {
    stroke: rgba(255, 255, 255, 0.5);
    stroke-width: 1.2;
  }

  .badge-shell--inner {
    stroke: rgba(255, 255, 255, 0.14);
    stroke-width: 1;
  }

  .badge-shell--rim {
    fill: none;
    stroke: color-mix(in oklab, var(--badge-accent-a), white 20%);
    stroke-width: 1.2;
    opacity: 0.72;
  }

  .badge-texture {
    opacity: 0.5;
    mix-blend-mode: screen;
  }

  .badge-circuit,
  .badge-icon {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .badge-circuit {
    stroke-width: 2;
  }

  .badge-icon {
    display: none;
    stroke-width: 4;
  }

  .whoami-badge-image[data-variant="code"] .badge-icon--code,
  .whoami-badge-image[data-variant="layers"] .badge-icon--layers,
  .whoami-badge-image[data-variant="flow"] .badge-icon--flow,
  .whoami-badge-image[data-variant="cube"] .badge-icon--cube,
  .whoami-badge-image[data-variant="devops"] .badge-icon--devops,
  .whoami-badge-image[data-variant="shield"] .badge-icon--shield {
    display: block;
  }

  .badge-glint {
    fill: none;
    stroke: rgba(255, 255, 255, 0.82);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.42;
  }

  .badge-scanline {
    fill: none;
    stroke: rgba(255, 255, 255, 0.85);
    stroke-width: 5;
    stroke-linecap: round;
    opacity: 0;
    mix-blend-mode: screen;
  }

  .whoami-badge-reflection,
  .whoami-badge-sheen {
    position: absolute;
    width: min(96%, 160px);
    aspect-ratio: 1;
    border-radius: 18px;
    clip-path: polygon(50% 2%, 93% 25%, 93% 75%, 50% 98%, 7% 75%, 7% 25%);
    transform: translate3d(0, -4px, 48px) rotateX(3deg) rotateY(-4deg);
    pointer-events: none;
  }

  .whoami-badge-reflection {
    background:
      linear-gradient(120deg, rgba(255, 255, 255, 0.34), transparent 24%, transparent 64%, rgba(255, 255, 255, 0.16)),
      radial-gradient(circle at 50% 20%, rgba(255, 255, 255, 0.18), transparent 32%);
    mix-blend-mode: screen;
    opacity: 0.34;
  }

  .whoami-badge-sheen {
    overflow: hidden;
    opacity: 0.8;
  }

  .whoami-badge-sheen::before {
    content: '';
    position: absolute;
    inset: -22% -60%;
    background: linear-gradient(105deg, transparent 42%, rgba(255, 255, 255, 0.62), transparent 56%);
    transform: translateX(-72%) rotate(0.001deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .whoami-badge-slide.is-active .whoami-badge-sheen::before {
      animation: badge-shine 3.8s var(--ease-standard) 0.45s infinite;
    }

    .whoami-badge-slide.is-active .whoami-badge-orbit {
      animation: badge-orbit-glow 4.8s ease-in-out infinite;
    }

    .whoami-badge-slide.is-active .whoami-badge-image {
      animation: badge-object-breathe 5.8s ease-in-out infinite;
    }

    .whoami-badge-slide.is-active .whoami-badge-art {
      animation: badge-side-showcase 6.4s ease-in-out infinite;
    }

    .whoami-badge-slide.is-active .badge-circuit {
      animation: badge-circuit-pulse 2.8s ease-in-out infinite;
    }

    .whoami-badge-slide.is-active .badge-icon {
      animation: badge-icon-float 3.4s ease-in-out infinite;
      transform-origin: 80px 88px;
    }

    .whoami-badge-slide.is-active .badge-glint {
      animation: badge-glint 3.6s ease-in-out infinite;
    }

    .whoami-badge-slide.is-active .badge-scanline {
      animation: badge-scanline 4.8s var(--ease-standard) 0.65s infinite;
    }
  }

  @keyframes badge-shine {
    0%, 42% {
      transform: translateX(-72%) rotate(0.001deg);
      opacity: 0;
    }
    52% {
      opacity: 0.85;
    }
    68%, 100% {
      transform: translateX(72%) rotate(0.001deg);
      opacity: 0;
    }
  }

  @keyframes badge-orbit-glow {
    0%, 100% {
      opacity: 0.72;
      filter: brightness(1);
    }
    50% {
      opacity: 1;
      filter: brightness(1.18);
