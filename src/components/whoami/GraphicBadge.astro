---
/**
 * GraphicBadge.astro
 * A reusable badge component that uses PNG assets with animated tooltips.
 * Enhanced with constant rotation and larger sizing.
 */
export type Props = {
  imageSrc: string;
  label: string;
  tooltip?: string;
  animation?: 'fade' | 'slide' | 'zoom';
  class?: string;
  rotateSpeed?: 'slow' | 'medium' | 'fast';
};

const { 
  imageSrc, 
  label, 
  tooltip, 
  animation = 'zoom',
  class: className,
  rotateSpeed = 'medium'
} = Astro.props;

const rotationDuration = {
  slow: '12s',
  medium: '8s',
  fast: '4s'
}[rotateSpeed];
---

<div 
  class:list={['graphic-badge', className]} 
  data-graphic-badge 
  data-animation={animation}
  role="img"
  aria-label={label}
>
  <div class="badge-wrapper">
    <div class="badge-container" style={`--rotation-duration: ${rotationDuration}`}>
      <img src={imageSrc} alt={label} class="badge-image" loading="lazy" />
      <div class="badge-glow"></div>
    </div>
  </div>

  {tooltip && (
    <div class="badge-tooltip" role="tooltip">
      <div class="tooltip-content">
        <p class="tooltip-label">{label}</p>
        <p class="tooltip-detail">{tooltip}</p>
      </div>
      <div class="tooltip-arrow"></div>
    </div>
  )}
</div>

<style>
  .graphic-badge {
    position: relative;
    display: inline-block;
    cursor: help;
    --tooltip-bg: color-mix(in oklab, var(--color-surface-2), transparent 2%);
    --tooltip-border: color-mix(in oklab, var(--color-border-strong), transparent 10%);
    --glow-color: var(--color-accent, #4cc9f0);
    padding: 0.5rem;
  }

  .badge-wrapper {
    position: relative;
    padding: 10px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,255,255,0.05) 0%, transparent 70%);
  }

  .badge-container {
    position: relative;
    width: 64px; /* Increased size */
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--motion-standard) var(--ease-standard);
    animation: badge-rotate var(--rotation-duration, 8s) linear infinite;
  }

  .badge-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 0 8px rgba(0, 0, 0, 0.6));
    z-index: 2;
    image-rendering: high-quality;
  }

  .badge-glow {
    position: absolute;
    inset: -10px;
    background: var(--glow-color);
    border-radius: 50%;
    filter: blur(15px);
    opacity: 0.1;
    transition: opacity var(--motion-standard) var(--ease-standard);
    z-index: 1;
  }

  /* Tooltip Base */
  .badge-tooltip {
    position: absolute;
    bottom: calc(100% + 15px);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    min-width: 180px;
    max-width: 260px;
    padding: 0.85rem 1rem;
    background: var(--tooltip-bg);
    border: 1px solid var(--tooltip-border);
    border-radius: 14px;
    backdrop-filter: blur(16px);
    box-shadow: 
      0 15px 35px rgba(0,0,0,0.4),
      inset 0 1px 1px rgba(255,255,255,0.1);
    z-index: 1000;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: 
      opacity var(--motion-standard) var(--ease-standard),
      transform var(--motion-standard) var(--ease-standard),
      visibility var(--motion-standard) var(--ease-standard);
  }

  .tooltip-content {
    display: grid;
    gap: 0.35rem;
  }

  .tooltip-label {
    margin: 0;
    font-size: var(--font-size-1);
    font-weight: 700;
    color: var(--color-text-strong);
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .tooltip-detail {
    margin: 0;
    font-size: var(--font-size-0);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .tooltip-arrow {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-right: 8px solid transparent;
    border-top: 8px solid var(--tooltip-border);
  }

  /* Hover States & Animations */
  .graphic-badge:hover .badge-wrapper {
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 80%);
  }

  .graphic-badge:hover .badge-container {
    transform: scale(1.15) translateY(-5px);
    animation-play-state: paused; /* Pause rotation on hover for readability */
  }

  .graphic-badge:hover .badge-glow {
    opacity: 0.4;
  }

  .graphic-badge:hover .badge-tooltip {
    opacity: 1;
    visibility: visible;
  }

  /* Rotation Animation */
  @keyframes badge-rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Animation Styles */
  [data-animation="fade"] .badge-tooltip {
    transform: translateX(-50%) translateY(8px);
  }
  .graphic-badge:hover[data-animation="fade"] .badge-tooltip {
    transform: translateX(-50%) translateY(0);
  }

  [data-animation="slide"] .badge-tooltip {
    transform: translateX(-50%) translateY(15px);
  }
  .graphic-badge:hover[data-animation="slide"] .badge-tooltip {
    transform: translateX(-50%) translateY(0);
  }

  [data-animation="zoom"] .badge-tooltip {
    transform: translateX(-50%) scale(0.8) translateY(12px);
    transform-origin: bottom center;
  }
  .graphic-badge:hover[data-animation="zoom"] .badge-tooltip {
    transform: translateX(-50%) scale(1) translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .badge-container {
      animation: none !important;
    }
    .graphic-badge:hover .badge-container {
      transform: none;
    }
    .badge-tooltip {
      transition: none !important;
      transform: translateX(-50%) !important;
    }
  }
</style>
