---
export type Props = {
  id: string;
  title: string;
  eyebrow?: string;
};

const { id, title, eyebrow } = Astro.props as Props;
---

<section class="whoami-subview card pad" id={id} data-whoami-subview>
  <header class="whoami-subview-header">
    {eyebrow ? <p class="whoami-subview-eyebrow">{eyebrow}</p> : null}
    <h2 class="whoami-subview-title">{title}</h2>
  </header>
  <div class="whoami-subview-body">
    <slot />
  </div>
</section>

<style>
  .whoami-subview {
    position: relative;
    overflow: hidden;
    background: color-mix(in oklab, var(--color-surface-2), transparent 14%);
    border-color: color-mix(in oklab, var(--color-border), transparent 5%);
    box-shadow:
      0 16px 38px var(--shadow-2),
      inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%),
      inset 0 -2px 0 color-mix(in oklab, var(--color-bg), transparent 0%);
  }

  .whoami-subview::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-accent), transparent 94%),
        transparent 54%
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.03) 0px,
        rgba(255, 255, 255, 0.012) 1px,
        rgba(255, 255, 255, 0) 4px
      );
    opacity: 0.18;
    pointer-events: none;
    mix-blend-mode: soft-light;
  }

  .whoami-subview::after {
    content: '';
    position: absolute;
    inset: 14px;
    border-radius: 18px;
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 30%);
    opacity: 0.65;
    pointer-events: none;
    clip-path: polygon(
      10px 0,
      calc(100% - 12px) 0,
      100% 12px,
      100% calc(100% - 12px),
      calc(100% - 12px) 100%,
      12px 100%,
      0 calc(100% - 12px),
      0 12px
    );
  }

  .whoami-subview-header {
    display: grid;
    gap: 0.25rem;
    margin-bottom: 0.75rem;
    position: relative;
    z-index: 1;
  }

  .whoami-subview-eyebrow {
    margin: 0;
    font-size: var(--font-size-0);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .whoami-subview-title {
    margin: 0;
    font-size: var(--font-size-4);
  }

  .whoami-subview-body :global(p:first-child) {
    margin-top: 0;
  }

  .whoami-subview-body {
    position: relative;
    z-index: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .whoami-subview {
      transition:
        transform var(--motion-fast) var(--ease-standard),
        box-shadow var(--motion-fast) var(--ease-standard);
    }

    .whoami-subview:hover {
      transform: translateY(-1px);
      box-shadow:
        0 18px 44px var(--shadow-2),
        inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%),
        inset 0 -2px 0 color-mix(in oklab, var(--color-bg), transparent 0%),
        0 0 0 1px color-mix(in oklab, var(--color-accent), transparent 86%);
    }
  }
</style>
