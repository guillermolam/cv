---
export type OperatorModuleNavItem = {
  id: string;
  label: string;
  iconHref: string;
};

export type Props = {
  label?: string;
  items: readonly OperatorModuleNavItem[];
};

const { label = 'Operator modules', items } = Astro.props as Props;
---

<nav class="op-section-nav" aria-label={label} data-whoami-keys>
  <ol class="op-section-nav-row" role="list">
    {items.map((item) => (
      <li>
        <button
          type="button"
          class="op-section-btn"
          data-key={item.id}
          data-whoami-key
          x-on:click={`setActive('${item.id}')`}
          x-bind:data-active={`is('${item.id}') ? 'true' : null`}
          x-bind:class={`is('${item.id}') ? 'active' : ''`}
          x-bind:aria-current={`is('${item.id}') ? 'true' : null`}
          x-bind:aria-pressed={`is('${item.id}') ? 'true' : 'false'`}
          aria-label={item.label}
        >
          <span
            class="op-section-icon"
            aria-hidden="true"
            style={`--op-icon-url:url('${item.iconHref}')`}
          ></span>
          <span class="op-section-label" aria-hidden="true">{item.label}</span>
        </button>
      </li>
    ))}
  </ol>
</nav>

<style>
  .op-section-nav {
    min-width: 0;
  }

  .op-section-nav-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
    overflow: visible;
  }

  @media (min-width: 760px) {
    .op-section-nav-row {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 0.55rem;
    }
  }

  .op-section-btn {
    --op-press: 0px;
    --op-glow: 0;
    --op-keylit: 0;

    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    width: 100%;
    min-width: 92px;
    height: 58px;
    border-radius: 12px;
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 10%);
    background:
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.03) 0px,
        rgba(255, 255, 255, 0.03) 2px,
        rgba(255, 255, 255, 0) 6px,
        rgba(255, 255, 255, 0) 12px
      ),
      radial-gradient(
        100% 90% at 30% 12%,
        color-mix(in oklab, var(--color-accent), transparent 90%),
        transparent 60%
      ),
      linear-gradient(180deg, var(--color-surface-2), var(--color-surface-3));
    box-shadow:
      0 18px 30px var(--shadow-2),
      inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%),
      inset 0 -4px 0 color-mix(in oklab, var(--color-bg), transparent 0%),
      inset 0 -14px 24px rgba(0, 0, 0, 0.22);
    cursor: pointer;
    font: inherit;
    color: var(--color-text-muted);
    padding: 0;
    position: relative;
    transform: translate3d(0, var(--op-press), 0);
    transform-style: preserve-3d;
    user-select: none;
  }

  .op-section-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(
        120% 140% at 30% 15%,
        rgba(255, 255, 255, 0.14),
        rgba(255, 255, 255, 0) 55%
      );
    opacity: 0.22;
    pointer-events: none;
    mix-blend-mode: soft-light;
  }

  .op-section-btn::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background:
      radial-gradient(
        120% 120% at 50% 10%,
        color-mix(in oklab, var(--color-accent), transparent 55%),
        transparent 58%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-accent), transparent 82%),
        transparent 60%
      );
    opacity: max(var(--op-glow), var(--op-keylit));
    pointer-events: none;
    transition: opacity var(--motion-fast) var(--ease-standard);
  }

  .op-section-btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .op-section-btn:active {
    --op-press: 2px;
    --op-glow: 0.9;
    box-shadow:
      0 12px 18px var(--shadow-2),
      inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%),
      inset 0 2px 10px color-mix(in oklab, var(--color-bg), transparent 0%);
  }

  .op-section-icon {
    width: 22px;
    height: 22px;
    margin-top: 0.25rem;
    background: color-mix(in oklab, var(--color-text-strong), var(--color-accent) 22%);
    -webkit-mask: var(--op-icon-url) center / contain no-repeat;
    mask: var(--op-icon-url) center / contain no-repeat;
    opacity: 0.92;
  }

  .op-section-label {
    margin-bottom: 0.35rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    color: var(--color-text-strong);
    opacity: 0.82;
    white-space: nowrap;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .op-section-icon {
      transition:
        background var(--motion-fast) var(--ease-standard),
        filter var(--motion-fast) var(--ease-standard),
        opacity var(--motion-fast) var(--ease-standard);
    }

    .op-section-label {
      transition:
        color var(--motion-fast) var(--ease-standard),
        opacity var(--motion-fast) var(--ease-standard);
    }

    .op-section-btn {
      transition:
        transform var(--motion-fast) var(--ease-standard),
        box-shadow var(--motion-fast) var(--ease-standard),
        border-color var(--motion-fast) var(--ease-standard),
        filter var(--motion-fast) var(--ease-standard);
    }

    .op-section-btn:hover,
    .op-section-btn:focus-visible {
      --op-glow: 0.6;
      transform: translate3d(0, -1px, 0) rotateX(2deg);
      border-color: color-mix(in oklab, var(--color-accent), transparent 56%);
      box-shadow:
        0 22px 38px var(--shadow-2),
        inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%),
        inset 0 -3px 0 color-mix(in oklab, var(--color-bg), transparent 0%),
        0 0 0 1px color-mix(in oklab, var(--color-accent), transparent 82%);
    }

    .op-section-btn[data-active='true'] {
      --op-glow: 0.8;
      --op-keylit: 0.85;
      border-color: color-mix(in oklab, var(--color-accent), transparent 40%);
      box-shadow:
        0 22px 38px var(--shadow-2),
        inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%),
        inset 0 -3px 0 color-mix(in oklab, var(--color-bg), transparent 0%),
        0 0 0 1px color-mix(in oklab, var(--color-accent), transparent 70%);
    }

    .op-section-btn[data-active='true'] .op-section-icon {
      background: color-mix(in oklab, var(--color-success), var(--color-text-strong) 18%);
      filter: drop-shadow(0 0 8px color-mix(in oklab, var(--color-success), transparent 68%));
    }
  }
</style>
