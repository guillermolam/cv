---
import type { ExperienceLogo, ExperienceCardViewModel } from '../../lib/content/experience-cards';

type Props = {
  logo: ExperienceLogo;
  companyName: string;
  importanceTier: ExperienceCardViewModel['importanceTier'];
  importanceScore: number;
};

const { logo, companyName, importanceTier, importanceScore } = Astro.props as Props;
const fallbackLabel = companyName
  .split(/\s+/)
  .map((part) => part[0] ?? '')
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<div
  class="experience-logo"
  data-tier={importanceTier}
  style={`--experience-logo-score:${importanceScore};`}
>
  <div class="experience-logo__body">
    {
      logo.src ? (
        <img
          src={logo.src}
          alt={logo.alt}
          loading="lazy"
          decoding="async"
          class:list={[
            'experience-logo__image',
            logo.hasVectorAsset && 'experience-logo__image--vector',
          ]}
        />
      ) : (
        <span class="experience-logo__fallback" aria-label={`${companyName} mark`}>
          {fallbackLabel}
        </span>
      )
    }
  </div>
</div>

<style>
  .experience-logo {
    --experience-logo-size: clamp(4.5rem, calc(4rem + (var(--experience-logo-score) * 0.5rem)), 7rem);
    display: grid;
    place-items: center;
    width: var(--experience-logo-size);
    height: var(--experience-logo-size);
    perspective: 1100px;
  }

  .experience-logo[data-tier='flagship'] {
    --experience-logo-size: clamp(5.75rem, 8vw, 8rem);
  }

  .experience-logo[data-tier='priority'] {
    --experience-logo-size: clamp(5rem, 7vw, 6.75rem);
  }

  .experience-logo__body {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 1rem;
    border-radius: 18px;
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 28%);
    background:
      linear-gradient(
        145deg,
        color-mix(in oklab, var(--color-surface-3), transparent 10%),
        color-mix(in oklab, var(--color-surface-2), transparent 18%)
      );
    box-shadow:
      inset 0 1px 0 color-mix(in oklab, white, transparent 88%),
      0 12px 28px rgb(0 0 0 / 0.28);
    transform-style: preserve-3d;
  }

  .experience-logo__body::before {
    content: '';
    position: absolute;
    inset: 0.35rem;
    border-radius: 14px;
    border: 1px solid color-mix(in oklab, var(--color-accent), transparent 78%);
    transform: translateZ(22px);
    pointer-events: none;
  }

  .experience-logo__body::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(
        135deg,
        color-mix(in oklab, white, transparent 92%) 0%,
        transparent 42%,
        color-mix(in oklab, var(--color-accent), transparent 90%) 100%
      );
    pointer-events: none;
  }

  .experience-logo__image {
    width: 100%;
    height: auto;
    max-height: calc(var(--experience-logo-size) * 0.44);
    object-fit: contain;
    transform: translateZ(34px);
    filter: drop-shadow(0 8px 20px rgb(0 0 0 / 0.24));
  }

  .experience-logo__image--vector {
    max-width: 88%;
  }

  .experience-logo__fallback {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: clamp(1.35rem, 2vw, 2rem);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-text-strong);
    transform: translateZ(32px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .experience-logo__body {
      transition:
        transform var(--motion-emphasis) var(--ease-emphasis),
        border-color var(--motion-standard) var(--ease-standard),
        box-shadow var(--motion-standard) var(--ease-standard);
      animation: experience-logo-idle 7.2s ease-in-out infinite;
    }

    .experience-logo:hover .experience-logo__body {
      transform: rotateX(10deg) rotateY(-12deg) translate3d(0, -3px, 0);
      border-color: color-mix(in oklab, var(--color-accent), transparent 44%);
      box-shadow:
        inset 0 1px 0 color-mix(in oklab, white, transparent 84%),
        0 18px 38px rgb(0 0 0 / 0.34);
    }
  }

  @keyframes experience-logo-idle {
    0%,
    100% {
      transform: rotateX(0deg) rotateY(0deg);
    }
    50% {
      transform: rotateX(4deg) rotateY(-5deg);
    }
  }
</style>
