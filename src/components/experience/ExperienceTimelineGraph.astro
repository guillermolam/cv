---
import UiBadge from '../ui/UiBadge.astro';
import UiIcon from '../ui/UiIcon.astro';
import type { ExperienceCardViewModel } from '../../lib/content/experience-cards';

type Props = {
  entries: ExperienceCardViewModel[];
};

const { entries } = Astro.props as Props;
---

<section class="experience-timeline" aria-labelledby="experience-timeline-title">
  <div class="experience-timeline__header">
    <div>
      <p class="experience-timeline__eyebrow">Career map</p>
      <h2 id="experience-timeline-title">Linked roles timeline</h2>
    </div>
    <UiBadge variant="info" size="sm" depth="flat">
      {entries.length} tracked roles
    </UiBadge>
  </div>

  <ol class="experience-timeline__list">
    {
      entries.map((entry, index) => (
        <li
          class="experience-timeline__item"
          data-tier={entry.importanceTier}
          style={`--experience-node-order:${index};`}
        >
          <a href={`#${entry.anchorId}`} class="experience-timeline__link">
            <span class="experience-timeline__dot" aria-hidden="true"></span>
            <span class="experience-timeline__glyph" aria-hidden="true">
              <UiIcon name="graph-link" size={18} decorative />
            </span>
            <span class="experience-timeline__date">{entry.dateRangeLabel}</span>
            <strong>{entry.companyName}</strong>
            <span>{entry.roleTitle}</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .experience-timeline {
    position: relative;
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
    border-radius: 24px;
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 30%);
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, white, transparent 96%) 0%,
        color-mix(in oklab, var(--color-surface-3), transparent 10%) 100%
      );
    overflow: hidden;
    box-shadow:
      0 24px 64px rgb(2 6 23 / 0.14),
      inset 0 1px 0 rgb(255 255 255 / 0.6);
    backdrop-filter: blur(14px);
  }

  .experience-timeline::before {
    content: '';
    position: absolute;
    inset: auto 1.2rem 2.45rem;
    height: 2px;
    background:
      linear-gradient(
        90deg,
        color-mix(in oklab, var(--color-accent), transparent 20%),
        color-mix(in oklab, var(--color-accent), transparent 82%)
      );
    pointer-events: none;
  }

  .experience-timeline__header,
  .experience-timeline__link {
    display: flex;
    justify-content: space-between;
    gap: 0.9rem;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .experience-timeline__eyebrow {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-00);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .experience-timeline__header h2 {
    margin: 0.3rem 0 0;
    font-size: clamp(1.25rem, 1vw + 1.05rem, 1.7rem);
    line-height: 1.05;
  }

  .experience-timeline__list {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .experience-timeline__item {
    position: relative;
  }

  .experience-timeline__link {
    position: relative;
    display: grid;
    gap: 0.28rem;
    align-content: start;
    min-height: 100%;
    padding: 0.95rem 0.95rem 0.95rem 1rem;
    border-radius: 18px;
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 34%);
    background:
      linear-gradient(
        180deg,
        color-mix(in oklab, white, transparent 96%) 0%,
        color-mix(in oklab, var(--color-surface-3), transparent 14%) 100%
      );
    text-decoration: none;
    color: inherit;
    box-shadow:
      0 16px 36px rgb(2 6 23 / 0.1),
      inset 0 1px 0 rgb(255 255 255 / 0.58);
  }

  .experience-timeline__glyph {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 28%);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-accent), transparent 92%);
    margin-bottom: 0.25rem;
  }

  .experience-timeline__dot {
    position: absolute;
    top: calc(100% + 0.55rem);
    left: 1.3rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 999px;
    border: 2px solid color-mix(in oklab, var(--color-accent), transparent 18%);
    background: color-mix(in oklab, var(--color-surface-1), transparent 4%);
    box-shadow: 0 0 0 0.28rem color-mix(in oklab, var(--color-accent), transparent 90%);
  }

  .experience-timeline__date {
    color: var(--color-text-muted);
    font-size: var(--font-size-00);
    font-weight: 500;
    text-transform: uppercase;
  }

  .experience-timeline__item[data-tier='flagship'] .experience-timeline__link strong {
    font-size: clamp(1.05rem, 0.4vw + 1rem, 1.26rem);
    line-height: 1.1;
  }

  .experience-timeline__item[data-tier='priority'] .experience-timeline__link strong {
    font-size: clamp(1rem, 0.32vw + 0.96rem, 1.18rem);
    line-height: 1.1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .experience-timeline__link {
      transition:
        transform var(--motion-fast) var(--ease-standard),
        border-color var(--motion-fast) var(--ease-standard),
        box-shadow var(--motion-fast) var(--ease-standard);
    }

    .experience-timeline__link:hover {
      transform: translateY(-2px);
      border-color: color-mix(in oklab, var(--color-accent), transparent 56%);
      box-shadow:
        0 22px 46px rgb(2 6 23 / 0.13),
        inset 0 1px 0 rgb(255 255 255 / 0.62);
    }

    .experience-timeline::after {
      content: '';
      position: absolute;
      inset: auto auto 2.1rem 1rem;
      width: 3.5rem;
      height: 0.25rem;
      border-radius: 999px;
      background: linear-gradient(
        90deg,
        color-mix(in oklab, var(--color-accent), transparent 18%),
        transparent
      );
      animation: experience-timeline-signal 5.8s linear infinite;
      pointer-events: none;
    }
  }

  @media (max-width: 48rem) {
    .experience-timeline::before,
    .experience-timeline::after,
    .experience-timeline__dot {
      display: none;
    }
  }

  @keyframes experience-timeline-signal {
    0% {
      transform: translateX(0);
      opacity: 0;
    }
    10%,
    80% {
      opacity: 1;
    }
    100% {
      transform: translateX(calc(100vw - 8rem));
      opacity: 0;
    }
  }
</style>
