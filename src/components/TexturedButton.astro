---
import { randomUUID } from 'node:crypto';

type Props = {
  href?: string;
  variant?: 'primary' | 'neutral';
  tooltip?: string;
  ariaLabel?: string;
  textureSrc?: string;
  target?: string;
  rel?: string;
  type?: 'button' | 'submit' | 'reset';
};

const {
  href,
  variant = 'neutral',
  tooltip,
  ariaLabel,
  textureSrc,
  target,
  rel,
  type = 'button',
} = Astro.props;

const tooltipId = tooltip ? `tbtn-tip-${randomUUID()}` : undefined;

const textureSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="220" height="220" viewBox="0 0 220 220">
<defs>
  <linearGradient id="g" x1="0" x2="1" y1="0" y2="1">
    <stop offset="0" stop-color="rgba(255,255,255,0.26)"/>
    <stop offset="1" stop-color="rgba(255,255,255,0.10)"/>
  </linearGradient>
  <pattern id="p" width="22" height="22" patternUnits="userSpaceOnUse">
    <path d="M0 11H22M11 0V22" stroke="rgba(255,255,255,0.10)" stroke-width="1"/>
    <path d="M3 5H10M12 17H19M5 3V10M17 12V19" stroke="rgba(255,255,255,0.16)" stroke-width="1"/>
    <circle cx="11" cy="11" r="1.25" fill="rgba(255,255,255,0.24)"/>
  </pattern>
</defs>
<rect width="220" height="220" fill="url(#p)"/>
<rect width="220" height="220" fill="url(#g)"/>
</svg>`;

const textureDataUrl = `data:image/svg+xml,${encodeURIComponent(textureSvg)}`;
const textureUrl = textureSrc ? `url("${textureSrc}")` : `url("${textureDataUrl}")`;

const className = ['tbtn', `tbtn-${variant}`].join(' ');
---

<div class="tbtn-wrap" data-tbtn-wrap>
  {
    href ? (
      <a
        class={className}
        href={href}
        target={target}
        rel={rel}
        aria-label={ariaLabel}
        aria-describedby={tooltipId}
        data-tbtn
        style={`--tbtn-texture:${textureUrl}`}
      >
        <span class="tbtn-label"><slot /></span>
      </a>
    ) : (
      <button
        class={className}
        type={type}
        aria-label={ariaLabel}
        aria-describedby={tooltipId}
        data-tbtn
        style={`--tbtn-texture:${textureUrl}`}
      >
        <span class="tbtn-label"><slot /></span>
      </button>
    )
  }
  {tooltip ? (
    <span class="tbtn-tip" id={tooltipId} role="tooltip">
      {tooltip}
    </span>
  ) : null}
</div>

<script>
  import initTexturedButtons from '../scripts/textured-button';
  initTexturedButtons();
</script>

<style>
  .tbtn-wrap {
    position: relative;
    display: inline-flex;
  }

  .tbtn {
    --tbtn-glow: 0;
    --tbtn-radius: 18px;
    --tbtn-h: 46px;

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: var(--tbtn-h);
    padding: 0 1.05rem;
    border-radius: var(--tbtn-radius);
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 15%);
    color: var(--color-text-strong);
    text-decoration: none;
    cursor: pointer;
    background: linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-surface-2), transparent 0%) 0%,
        color-mix(in oklab, var(--color-surface-3), transparent 0%) 100%
      ),
      radial-gradient(
        120% 90% at 50% 10%,
        color-mix(in oklab, var(--color-accent), transparent 88%),
        transparent 60%
      );
    box-shadow:
      0 14px 30px var(--shadow-2),
      inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%),
      inset 0 -1px 0 color-mix(in oklab, var(--color-bg), transparent 10%);
    user-select: none;
    transform: translate3d(0, 0, 0);
  }

  .tbtn::before {
    content: '';
    position: absolute;
    inset: 1px;
    border-radius: calc(var(--tbtn-radius) - 1px);
    background-image: var(--tbtn-texture);
    opacity: 0.38;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .tbtn::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: calc(var(--tbtn-radius) + 2px);
    background: radial-gradient(
      90% 120% at 50% 20%,
      color-mix(in oklab, var(--color-accent), transparent 55%),
      transparent 70%
    );
    opacity: calc(var(--tbtn-glow) * 0.75);
    filter: blur(10px);
    pointer-events: none;
  }

  .tbtn-label {
    font-size: var(--font-size-1);
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .tbtn-primary {
    border-color: color-mix(in oklab, var(--color-cta), transparent 40%);
    background: linear-gradient(
        180deg,
        color-mix(in oklab, var(--color-cta), transparent 20%) 0%,
        color-mix(in oklab, var(--color-cta), transparent 40%) 100%
      ),
      radial-gradient(
        120% 90% at 50% 10%,
        color-mix(in oklab, var(--color-accent), transparent 80%),
        transparent 65%
      );
  }

  .tbtn:active {
    transform: translate3d(0, 2px, 0) scale(0.985);
    box-shadow:
      0 10px 22px var(--shadow-2),
      inset 0 1px 0 color-mix(in oklab, var(--color-border-strong), transparent 35%),
      inset 0 2px 10px color-mix(in oklab, var(--color-bg), transparent 0%);
  }

  .tbtn-tip {
    position: absolute;
    left: 50%;
    top: calc(100% + 10px);
    transform: translateX(-50%) translateY(-4px);
    padding: 0.45rem 0.65rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: color-mix(in oklab, var(--color-surface-2), transparent 6%);
    color: var(--color-text-muted);
    font-size: var(--font-size-0);
    white-space: nowrap;
    box-shadow: 0 12px 28px var(--shadow-2);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-standard);
    z-index: var(--z-tooltip);
  }

  .tbtn-wrap[data-tip-open='true'] .tbtn-tip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (max-width: 420px) {
    .tbtn-tip {
      max-width: min(88vw, 320px);
      white-space: normal;
      text-align: center;
    }
  }
</style>
