---
import ProfilePortrait from './ProfilePortrait.astro';
import { site } from '../lib/site';

type Props = {
  size?: 'sm' | 'md' | 'lg';
  ariaLabel?: string;
};

const { size = 'lg', ariaLabel = `3D avatar of ${site.name}` } = Astro.props;

const sizes = {
  sm: 72,
  md: 128,
  lg: 196,
};

const dimension = sizes[size] ?? sizes.md;
const src = site.profile.avatarModelPath;
---

<div
  class="avatar3d"
  style={`--avatar-size:${dimension}px`}
  role="img"
  aria-label={ariaLabel}
  data-avatar3d
>
  <model-viewer
    src={src}
    alt={ariaLabel}
    camera-controls
    auto-rotate
    rotation-per-second="18deg"
    interaction-prompt="none"
    shadow-intensity="0.6"
    loading="lazy"
    touch-action="pan-y"
    tabindex="0"></model-viewer>
  <div class="avatar3d-fallback" aria-hidden="true">
    <ProfilePortrait size={size} />
  </div>
</div>

<script>
  (async () => {
    try {
      await import('@google/model-viewer');
    } catch {
      return;
    }

    const media = window.matchMedia('(prefers-reduced-motion: reduce)');

    const hosts = Array.from(document.querySelectorAll('[data-avatar3d]'));
    for (const host of hosts) {
      const modelViewer = host.querySelector('model-viewer');
      if (!modelViewer) continue;

      const setLoaded = (loaded: boolean) => {
        if (loaded) host.setAttribute('data-avatar3d-loaded', 'true');
        else host.removeAttribute('data-avatar3d-loaded');
      };

      setLoaded(false);

      const apply = () => {
        if (media.matches) {
          modelViewer.removeAttribute('auto-rotate');
        } else {
          modelViewer.setAttribute('auto-rotate', '');
        }
      };

      apply();

      modelViewer.addEventListener(
        'load',
        () => {
          setLoaded(true);
        },
        { once: true },
      );

      modelViewer.addEventListener('error', () => {
        setLoaded(false);
      });

      media.addEventListener('change', apply);
    }
  })();
</script>

<style>
  .avatar3d {
    width: var(--avatar-size);
    height: var(--avatar-size);
    border-radius: 999px;
    border: 1px solid var(--color-border);
    overflow: hidden;
    background: radial-gradient(
      circle at 35% 25%,
      color-mix(in oklab, var(--color-accent), transparent 75%),
      color-mix(in oklab, var(--color-surface-3), transparent 5%)
    );
    box-shadow: 0 14px 34px var(--shadow-2);
    position: relative;
    display: grid;
    place-items: center;
  }

  model-viewer {
    display: block;
    width: 100%;
    height: 100%;
    background: transparent;
  }

  model-viewer:not(:defined) {
    display: none;
  }

  .avatar3d[data-avatar3d-loaded='true'] .avatar3d-fallback {
    display: none;
  }

  .avatar3d-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
</style>
