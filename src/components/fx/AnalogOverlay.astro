---
/**
 * AnalogOverlay.astro
 * Provides a global film grain and scanline effect using zero-asset CSS and SVG.
 * Extremely low compute/memory footprint.
 */
---

<div class="analog-overlay" aria-hidden="true">
  <div class="grain"></div>
  <div class="scanlines"></div>
</div>

<svg style="display: none;">
  <filter id="analog-noise">
    <feTurbulence 
      type="fractalNoise" 
      baseFrequency="0.65" 
      numOctaves="3" 
      stitchTiles="stitch" 
    />
    <feColorMatrix type="saturate" values="0" />
    <feComponentTransfer>
      <feFuncR type="linear" slope="0.1" />
      <feFuncG type="linear" slope="0.1" />
      <feFuncB type="linear" slope="0.1" />
    </feComponentTransfer>
  </filter>
</svg>

<style>
  .analog-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9999;
    overflow: hidden;
    opacity: 0.25; /* Adjust for intensity */
  }

  .grain {
    position: absolute;
    width: 200%;
    height: 200%;
    top: -50%;
    left: -50%;
    filter: url(#analog-noise);
    animation: grain-animation 0.5s steps(5) infinite;
  }

  .scanlines {
    position: absolute;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
      to bottom,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.05) 2px,
      rgba(0, 0, 0, 0.05) 4px
    );
  }

  @keyframes grain-animation {
    0% { transform: translate(0, 0); }
    10% { transform: translate(-5%, -5%); }
    20% { transform: translate(-10%, 5%); }
    30% { transform: translate(5%, -10%); }
    40% { transform: translate(-5%, 15%); }
    50% { transform: translate(-10%, 5%); }
    60% { transform: translate(15%, 0); }
    70% { transform: translate(0, 10%); }
    80% { transform: translate(-15%, 0); }
    90% { transform: translate(10%, 5%); }
    100% { transform: translate(5%, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .grain {
      animation: none;
    }
  }
</style>
