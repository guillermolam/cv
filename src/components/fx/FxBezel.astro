---
/**
 * FxBezel — rusty/vintage metallic console housing.
 *
 * Renders a thick brushed-metal frame with corner screws, a patina edge,
 * and an inset well for content (slot). The whole control room sits inside this.
 *
 * Decorative frame is aria-hidden; the slotted content carries semantics.
 */
export type Props = {
  class?: string;
  /** corner screw size in px */
  screw?: number;
  /** show oxide/rust streaks */
  rust?: boolean;
  label?: string;
};

const { class: className, screw = 14, rust = true, label } = Astro.props as Props;
const corners = ['tl', 'tr', 'bl', 'br'] as const;
---

<div class:list={['fx-bezel', className]} data-fx-bezel role="group" aria-label={label}>
  <div class="fx-bezel-frame" aria-hidden="true">
    {rust && <span class="fx-bezel-rust"></span>}
    {corners.map((c) => (
      <span class:list={['fx-bezel-screw', `fx-bezel-screw--${c}`]}>
        <span class="fx-bezel-screw-slot"></span>
      </span>
    ))}
  </div>
  <div class="fx-bezel-well">
    <slot />
  </div>
</div>

<style define:vars={{ screwSize: `${screw}px` }}>
  .fx-bezel {
    position: relative;
    border-radius: 22px;
    padding: clamp(0.9rem, 2.2vw, 1.6rem);
    background:
      /* bronze sheen sweeping across the top edge */
      linear-gradient(
        100deg,
        transparent 0%,
        color-mix(in oklab, var(--fx-metal-bronze), transparent 70%) 18%,
        transparent 38%,
        transparent 64%,
        color-mix(in oklab, var(--fx-metal-bronze), transparent 78%) 82%,
        transparent 100%
      ),
      linear-gradient(180deg, var(--fx-metal-2), var(--fx-metal-base) 62%, #0d0b08);
    border: 1px solid var(--fx-metal-edge);
    box-shadow:
      0 40px 90px var(--shadow-2),
      inset 0 2px 0 var(--fx-metal-highlight),
      inset 0 0 0 1px color-mix(in oklab, var(--fx-metal-bronze), transparent 80%),
      inset 0 -3px 10px rgba(0, 0, 0, 0.6);
    isolation: isolate;
  }

  .fx-bezel-frame {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    /* brushed-metal micro-grooves */
    background-image: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.025) 0px,
      rgba(255, 255, 255, 0.025) 1px,
      rgba(0, 0, 0, 0.04) 2px,
      rgba(0, 0, 0, 0.04) 3px
    );
    opacity: 0.6;
    mix-blend-mode: overlay;
  }

  .fx-bezel-rust {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background:
      radial-gradient(60% 40% at 8% 0%, color-mix(in oklab, var(--fx-rust-oxide), transparent 70%), transparent 60%),
      radial-gradient(50% 36% at 100% 100%, color-mix(in oklab, var(--fx-rust-mid), transparent 72%), transparent 58%),
      radial-gradient(40% 30% at 92% 4%, color-mix(in oklab, var(--fx-rust-hi), transparent 78%), transparent 60%);
    mix-blend-mode: soft-light;
    opacity: 0.7;
  }

  /* ── Corner screws ───────────────────────────────────────────────────── */
  .fx-bezel-screw {
    position: absolute;
    width: var(--screwSize);
    height: var(--screwSize);
    border-radius: 50%;
    background: var(--fx-screw);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.25),
      0 1px 2px rgba(0, 0, 0, 0.7);
    display: grid;
    place-items: center;
  }

  .fx-bezel-screw-slot {
    width: 64%;
    height: 2px;
    border-radius: 2px;
    background: rgba(0, 0, 0, 0.6);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.12);
    transform: rotate(35deg);
  }

  .fx-bezel-screw--tl { top: 8px; left: 8px; }
  .fx-bezel-screw--tr { top: 8px; right: 8px; }
  .fx-bezel-screw--bl { bottom: 8px; left: 8px; }
  .fx-bezel-screw--br { bottom: 8px; right: 8px; }

  /* ── Inner well ──────────────────────────────────────────────────────── */
  .fx-bezel-well {
    position: relative;
    border-radius: 16px;
    padding: clamp(0.75rem, 1.8vw, 1.25rem);
    background:
      var(--fx-vignette),
      color-mix(in oklab, var(--color-bg), transparent 8%);
    border: 1px solid color-mix(in oklab, var(--color-border-strong), transparent 20%);
    box-shadow:
      inset 0 2px 14px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    overflow: hidden;
  }

  @media (max-width: 520px) {
    .fx-bezel {
      border-radius: 16px;
      padding: 0.7rem;
    }
    .fx-bezel-screw { width: 10px; height: 10px; }
  }
</style>
