---
/**
 * GeometricalBackground.astro
 * Provides a global, animated geometrical background using Three.js.
 * Mixes trigonometric waves and value noise for a retro-futuristic look.
 */
---

<div class="global-background" aria-hidden="true" data-global-background>
  <div class="canvas-mount" data-mount></div>
</div>

<script>
  import { Engine } from '../../scripts/three/Engine';
  import { GeometricalBackgroundEffect } from '../../scripts/three/effects/GeometricalBackgroundEffect';

  async function initBackground() {
    const mount = document.querySelector('[data-global-background] [data-mount]');
    if (!(mount instanceof HTMLElement)) return;

    const engine = new Engine(mount);
    const scene = engine.getScene();

    // Subtle Cyan/Blue theme
    const effect = new GeometricalBackgroundEffect(scene, 0x4cc9f0);
    engine.addEffect(effect);

    // Position camera high and looking down
    engine.getCamera().position.set(0, 15, 20);
    engine.getCamera().lookAt(0, 0, 0);

    // Minimal fog for depth
    engine.setFog('#08111f', 0.04);
  }

  // Only initialize if we're not in a low-power preference mode
  const media = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!media.matches) {
    initBackground();
  }
</script>

<style>
  .global-background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -2; /* Behind everything */
    pointer-events: none;
    overflow: hidden;
    background: #08111f; /* Base dark color */
  }

  .canvas-mount {
    width: 100%;
    height: 100%;
  }

  /* Ensure the background doesn't pop in too harshly */
  @keyframes background-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .global-background {
    animation: background-fade-in 1.5s ease-out;
  }
</style>
