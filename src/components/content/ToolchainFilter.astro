---
export type Option = { id: string; label: string };

export type Props = {
  targetSelector: string;
  typeOptions: Option[];
  tagOptions: Option[];
  categoryOptions: Option[];
  totalCount: number;
};

const { targetSelector, typeOptions, tagOptions, categoryOptions, totalCount } = Astro.props as Props;

const uid = `toolchain-filter-${Math.random().toString(16).slice(2)}`;
const idType = `${uid}-type`;
const idTag = `${uid}-tag`;
const idCategory = `${uid}-category`;
---

<div class="tc-filter-panel" data-toolchain-filter data-target={targetSelector}>
  <form class="tc-filter-form">
    <fieldset class="tc-filter-fieldset">
      <legend class="tc-filter-legend ds-label">
        <span class="i-ph-funnel-duotone align-middle mr-1" aria-hidden="true"></span>
        Filter
      </legend>

      <div class="tc-filter-grid">
        <div class="tc-filter-control">
          <label class="ds-label" for={idType}>Type</label>
          <select id={idType} class="tc-filter-select" data-filter-type>
            <option value="">All</option>
            {typeOptions.map((o) => (
              <option value={o.id}>{o.label}</option>
            ))}
          </select>
        </div>

        <div class="tc-filter-control">
          <label class="ds-label" for={idCategory}>Category</label>
          <select id={idCategory} class="tc-filter-select" data-filter-category>
            <option value="">All</option>
            {categoryOptions.map((o) => (
              <option value={o.id}>{o.label}</option>
            ))}
          </select>
        </div>

        <div class="tc-filter-control">
          <label class="ds-label" for={idTag}>Tag</label>
          <select id={idTag} class="tc-filter-select" data-filter-tag>
            <option value="">All</option>
            {tagOptions.map((o) => (
              <option value={o.id}>{o.label}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="tc-filter-actions">
        <p class="tc-filter-count ds-telemetry" data-filter-count aria-live="polite">
          <span class="i-ph-database-duotone align-middle mr-1" aria-hidden="true"></span>
          Showing {totalCount} of {totalCount}
        </p>
        <button class="ds-btn-ghost" type="button" data-filter-reset>
          <span class="i-ph-arrow-counter-clockwise-duotone align-middle mr-1" aria-hidden="true"></span>
          Reset
        </button>
      </div>
    </fieldset>
  </form>
</div>

<script>
  import { initToolchainFilters } from '../../scripts/content-filters';
  initToolchainFilters();
</script>

<style>
  .tc-filter-panel {
    @apply ds-panel;
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-1);
  }

  .tc-filter-fieldset {
    border: none;
    margin: 0;
    padding: 0;
  }

  .tc-filter-legend {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    width: 100%;
    display: block;
  }

  .tc-filter-grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    align-items: end;
  }

  .tc-filter-control {
    display: grid;
    gap: var(--space-1);
  }

  .tc-filter-select {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 0.5rem 0.65rem;
    background: color-mix(in oklab, var(--color-surface-2), transparent 10%);
    color: var(--color-text-strong);
    font-family: var(--font-mono);
    font-size: var(--font-size-0);
    transition: border-color 0.15s ease;
  }
  .tc-filter-select:focus {
    border-color: var(--color-cta);
    outline: none;
    box-shadow: 0 0 0 2px color-mix(in oklab, var(--color-cta), transparent 75%);
  }

  .tc-filter-actions {
    margin-top: var(--space-3);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .tc-filter-count {
    margin: 0;
    display: none;
  }

  .tc-filter-panel[data-filter-enhanced='true'] .tc-filter-count {
    display: flex;
  }
</style>
