---
type Props = {
  modelUrl?: string;
  color?: string;
  class?: string;
};

const { 
  modelUrl = '/3d/models/meshy_2_1780590664152.glb', 
  color = '#00ffcc',
  class: className 
} = Astro.props;
---

<div class:list={['retro-wireframe-container', className]} data-retro-wireframe data-model={modelUrl} data-color={color}>
  <div class="canvas-mount" data-mount></div>
</div>

<script>
  import { Engine } from '../../scripts/three/Engine';
  import { TrigWireframeWave } from '../../scripts/three/effects/TrigWireframeWave';
  // @ts-ignore
  import * as THREE from 'three';

  async function initWireframe() {
    const containers = document.querySelectorAll('[data-retro-wireframe]');
    
    for (const container of containers) {
      if (!(container instanceof HTMLElement)) continue;
      if (container.dataset.initialized === 'true') continue;
      
      const mount = container.querySelector('[data-mount]');
      if (!(mount instanceof HTMLElement)) continue;

      const modelUrl = container.dataset.model;
      const colorStr = container.dataset.color || '#00ffcc';
      const color = new THREE.Color(colorStr).getHex();

      const engine = new Engine(mount);
      const scene = engine.getScene();

      // Add Wave Effect
      const wave = new TrigWireframeWave(scene, color);
      engine.addEffect(wave);

      // Position camera
      engine.getCamera().position.set(0, 4, 8);
      engine.getCamera().lookAt(0, 0, 0);

      // Add Lighting
      const ambientLight = new THREE.AmbientLight(0xffffff, 0.4);
      scene.add(ambientLight);
      const pointLight = new THREE.PointLight(0xffffff, 1);
      pointLight.position.set(-5, 5, 5);
      scene.add(pointLight);

      // Load Model
      if (modelUrl) {
        try {
          const model = await Engine.loadModel(modelUrl);
          model.scale.set(1.2, 1.2, 1.2);
          model.position.y = 1.5;
          scene.add(model);
          
          engine.addEffect({
            update: (time) => {
              model.rotation.y = -time * 0.15;
              model.position.y = 1.5 + Math.cos(time * 0.8) * 0.15;
            },
            destroy: () => {}
          });
        } catch (err) {
          console.error('Failed to load wireframe model:', err);
        }
      }

      container.dataset.initialized = 'true';
    }
  }

  initWireframe();
</script>

<style>
  .retro-wireframe-container {
    width: 100%;
    height: 400px;
    position: relative;
    overflow: hidden;
    background: #000;
    border-radius: var(--radius-2, 8px);
    border: 1px solid var(--color-border, #333);
  }

  .canvas-mount {
    width: 100%;
    height: 100%;
  }
</style>
