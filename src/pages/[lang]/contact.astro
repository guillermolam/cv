---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangStaticPaths, isLang } from '../../lib/i18n';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
if (!lang || !isLang(lang)) {
  throw new Error('Invalid language');
}

const title = 'Contact';
const description = 'Ways to reach me.';
---

<BaseLayout title={title} description={description} lang={lang} useLangPrefix>
  <section class="card pad">
    <h1>Contact</h1>
    <p>This route is a Phase 1 placeholder for i18n foundation.</p>
    <ul>
      <li>
        Email:
        <a href="mailto:guillermolam.m@gmail.com">guillermolam.m@gmail.com</a>
      </li>
      <li>
        LinkedIn:
        <a href="https://linkedin.com/in/guillermo-lam-28901047"
          >linkedin.com/in/guillermo-lam-28901047</a
        >
      </li>
      <li>
        GitHub: <a href="https://github.com/guillermolam">github.com/guillermolam</a>
      </li>
    </ul>
  </section>
</BaseLayout>

