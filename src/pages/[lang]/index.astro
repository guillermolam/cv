---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ControlRoomConsole from '../../components/control-room/ControlRoomConsole.astro';
import { getLangStaticPaths, isLang } from '../../lib/i18n';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
if (!lang || !isLang(lang)) {
  throw new Error('Invalid language');
}

const prefix = `/${lang}`;

const title = 'Hybrid Cloud Control Room';
const description =
  'Cloud Security & DevSecOps Engineer. I build secure delivery pipelines, cloud-native platforms, and pragmatic guardrails that help teams ship with confidence.';
---

<BaseLayout title={title} description={description} lang={lang} useLangPrefix>
  <ControlRoomConsole lang={lang} prefix={prefix} />
</BaseLayout>
