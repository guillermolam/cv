---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getLangStaticPaths, isLang } from '../../../lib/i18n';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
if (!lang || !isLang(lang)) {
  throw new Error('Invalid language');
}

const title = 'Portfolio · Security';
const description = 'Security work highlights.';
const prefix = `/${lang}`;
---

<BaseLayout title={title} description={description} lang={lang} useLangPrefix>
  <section class="card pad">
    <h1>Security</h1>
    <p>This route is a Phase 1 placeholder for i18n foundation.</p>
    <div class="cta-row">
      <a class="button" href={`${prefix}/portfolio`}>Back to portfolio</a>
      <a class="button primary" href={`${prefix}/cv`}>Download CV</a>
    </div>
  </section>
</BaseLayout>

