---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TaxonomyPills from '../../../components/content/TaxonomyPills.astro';

import { getCollection, render } from 'astro:content';
import { SUPPORTED_LANGS, isLang } from '../../../lib/i18n';
import { buildContentGraph, getNodeKey, type ContentGraphNode } from '../../../lib/content/graph';
import { getBacklinks, getOutgoingLinks } from '../../../lib/content/backlinks';
import { scoreRelatedEntries } from '../../../lib/content/relationships';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const slugs = projects.map((p) => p.data.projectId);
  return SUPPORTED_LANGS.flatMap((lang) => slugs.map((slug) => ({ params: { lang, slug } })));
}

const { lang, slug } = Astro.params;
if (!lang || !isLang(lang)) {
  throw new Error('Invalid language');
}
if (!slug) {
  throw new Error('Missing slug');
}

const projectsAll = await getCollection('projects');
const categoriesAll = await getCollection('categories');
const tagsAll = await getCollection('tags');
const toolsAll = await getCollection('tools');
const skillsAll = await getCollection('skills');

const projectLang = projectsAll.find((p) => p.data.projectId === slug && p.data.lang === lang);
const projectEn = projectsAll.find((p) => p.data.projectId === slug && p.data.lang === 'en');
const project = projectLang ?? projectEn;
if (!project) {
  throw new Error(`Project not found: ${slug}`);
}

const categoryTitleById = new Map(categoriesAll.map((c) => [c.data.categoryId, c.data.title] as const));
const tagTitleById = new Map(tagsAll.map((t) => [t.data.tagId, t.data.title] as const));
const toolTitleById = new Map(toolsAll.map((t) => [t.data.toolId, t.data.name] as const));
const skillTitleById = new Map(skillsAll.map((s) => [s.data.skillId, s.data.name] as const));

const graph = await buildContentGraph();
const nodeByKey = new Map(graph.nodes.map((n) => [n.key, n] as const));
const isGraphNode = (value: ContentGraphNode | undefined): value is ContentGraphNode => Boolean(value);

const nodeKey = getNodeKey('projects', project.data.projectId);
const outgoing = getOutgoingLinks(nodeKey, graph);
const backlinks = getBacklinks(nodeKey, graph);
const related = scoreRelatedEntries(nodeKey, graph).slice(0, 8);

const categories = (project.data.categoryIds ?? [])
  .map((id) => categoryTitleById.get(id))
  .filter((label): label is string => typeof label === 'string')
  .map((label) => ({ label }));
const tags = (project.data.tagIds ?? [])
  .map((id) => tagTitleById.get(id))
  .filter((label): label is string => typeof label === 'string')
  .map((label) => ({ label }));
const tools = (project.data.toolIds ?? [])
  .map((id) => toolTitleById.get(id))
  .filter((label): label is string => typeof label === 'string')
  .map((label) => ({ label }));
const skills = (project.data.skillIds ?? [])
  .map((id) => skillTitleById.get(id))
  .filter((label): label is string => typeof label === 'string')
  .map((label) => ({ label }));

const outgoingLinks = outgoing
  .map((e) => nodeByKey.get(e.to))
  .filter(isGraphNode)
  .map((n) => ({ label: n.title, href: n.url ?? `/${lang}/content-index` }));

const incomingLinks = backlinks
  .map((e) => nodeByKey.get(e.from))
  .filter(isGraphNode)
  .map((n) => ({ label: n.title, href: n.url ?? `/${lang}/content-index` }));

const relatedLinks = related
  .map((r) => nodeByKey.get(r.nodeKey))
  .filter(isGraphNode)
  .map((n) => ({ label: n.title, href: n.url ?? `/${lang}/content-index` }));

const { Content } = await render(project);

const title = project.data.title;
const description = project.data.summary;
---

<BaseLayout title={title} description={description} lang={lang} useLangPrefix>
  <section class="card pad">
    <h1>{project.data.title}</h1>
    {projectLang ? null : lang !== 'en' ? (
      <p class="topology-subtitle">Showing English content while {lang.toUpperCase()} content is being authored.</p>
    ) : null}
    <p class="topology-subtitle">Status: {project.data.status}</p>
    <p>{project.data.summary}</p>

    <div class="cta-row">
      {project.data.repoUrl ? (
        <a class="button" href={project.data.repoUrl} rel="noopener noreferrer" target="_blank">
          Repo
        </a>
      ) : null}
      {project.data.demoUrl ? (
        <a class="button" href={project.data.demoUrl} rel="noopener noreferrer" target="_blank">
          Demo
        </a>
      ) : null}
      {project.data.deploymentUrl ? (
        <a class="button" href={project.data.deploymentUrl} rel="noopener noreferrer" target="_blank">
          Deployment
        </a>
      ) : null}
      <a class="button" href={`/${lang}/portfolio`}>Back to portfolio</a>
    </div>
  </section>

  <section class="grid">
    {tools.length > 0 ? <TaxonomyPills label="Tools" items={tools} /> : null}
    {skills.length > 0 ? <TaxonomyPills label="Skills" items={skills} /> : null}
    {categories.length > 0 ? <TaxonomyPills label="Categories" items={categories} /> : null}
    {tags.length > 0 ? <TaxonomyPills label="Tags" items={tags} /> : null}
  </section>

  <section class="card pad">
    <h2>Details</h2>
    <Content />
  </section>

  <section class="grid cols-2">
    <div class="card pad">
      <h2>Links</h2>
      {outgoingLinks.length > 0 ? (
        <ul>
          {outgoingLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="topology-subtitle">No outgoing links yet.</p>
      )}
    </div>

    <div class="card pad">
      <h2>Backlinks</h2>
      {incomingLinks.length > 0 ? (
        <ul>
          {incomingLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="topology-subtitle">No backlinks yet.</p>
      )}
    </div>
  </section>

  <section class="card pad">
    <h2>Related</h2>
    {relatedLinks.length > 0 ? (
      <div class="station-chips">
        {relatedLinks.map((l) => (
          <a class="station-chip" href={l.href}>
            {l.label}
          </a>
        ))}
      </div>
    ) : (
      <p class="topology-subtitle">No related entries yet.</p>
    )}
  </section>
</BaseLayout>
