---
/**
 * /[lang]/knowledge — Knowledge Center
 *
 * Design: ops-dashboard aesthetic matching experience.astro.
 *  - Hero + stats ribbon
 *  - View toggle: Dashboard (card grid + charts) ↔ Graph (Three.js force-directed)
 *  - 2-level taxonomy: Human audience vs Agent audience
 *  - Faceted filter: audience | type | level | status | category | tool | tag
 *  - Pagination: 50 items per page, resets on filter change
 *  - Charts: LazyBarChart for Human resource breakdown + Agent resource breakdown
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContentCard from '../../../components/content/ContentCard.astro';
import TaxonomyPills from '../../../components/content/TaxonomyPills.astro';
import LazyBarChart from '../../../components/charts/LazyBarChart.astro';

import { getCollection, type CollectionEntry } from 'astro:content';
import { getLangStaticPaths, isLang } from '../../../lib/i18n';

export function getStaticPaths() {
  return getLangStaticPaths();
}

const { lang } = Astro.params;
if (!lang || !isLang(lang)) throw new Error('Invalid language');

const title = 'Knowledge Center';
const description =
  'Curated resources across security engineering, operations, architecture, and AI tooling — organised by audience and domain.';

// ── Collections ──────────────────────────────────────────────────────────────
const resourcesAll = await getCollection('knowledgeResources');
const categoriesAll = await getCollection('categories');
const tagsAll = await getCollection('tags');
const toolsAll = await getCollection('tools');
const skillsAll = await getCollection('skills');
const projectsAll = await getCollection('projects');
const caseStudiesAll = await getCollection('caseStudies');
const blogAll = await getCollection('blog');

const resources = resourcesAll.filter((r) => r.data.lang === lang);
const resourcesFallback =
  resources.length > 0
    ? resources
    : resourcesAll.filter((r) => r.data.lang === 'en');

// ── Look-up maps ─────────────────────────────────────────────────────────────
const categoryTitleById = new Map(
  categoriesAll.map((c) => [c.data.categoryId, c.data.title] as const),
);
const tagTitleById = new Map(
  tagsAll.map((t) => [t.data.tagId, t.data.title] as const),
);
const toolTitleById = new Map(
  toolsAll.map((t) => [t.data.toolId, t.data.name] as const),
);
const skillTitleById = new Map(
  skillsAll.map((s) => [s.data.skillId, s.data.name] as const),
);
const projectTitleById = new Map(
  projectsAll.map((p) => [p.data.projectId, p.data.title] as const),
);
const caseStudyMetaById = new Map(
  caseStudiesAll.map(
    (c) =>
      [c.data.caseStudyId, { title: c.data.title, slug: c.data.slug }] as const,
  ),
);

const isDraftBlog = (e: CollectionEntry<'blog'>) =>
  Boolean(e.data?.draft) || e.data?.visibility === 'draft';
const publishedBlogSlugs = new Set(
  blogAll.filter((b) => !isDraftBlog(b)).map((b) => b.data.blogSlug),
);

// ── Audience taxonomy ────────────────────────────────────────────────────────
const HUMAN_TYPES = new Set([
  'book',
  'article',
  'paper',
  'video',
  'course',
  'repo',
  'github-repo',
  'documentation',
  'talk',
  'documentary',
  'playlist',
  'podcast',
  'workshop',
]);
const AGENT_TYPES = new Set([
  'mcp',
  'skill',
  'plugin',
  'tool',
  'platform',
  'llm-model',
  'example',
  'cli',
  'md-doc',
]);

const deriveAudience = (type: string): 'human' | 'agent' | 'other' => {
  if (HUMAN_TYPES.has(type)) return 'human';
  if (AGENT_TYPES.has(type)) return 'agent';
  return 'other';
};

const TYPE_LABELS: Record<string, string> = {
  book: 'Book',
  article: 'Article',
  paper: 'Paper',
  video: 'Video',
  course: 'Course',
  repo: 'Repo',
  'github-repo': 'GitHub Repo',
  documentation: 'Documentation',
  talk: 'Talk',
  documentary: 'Documentary',
  playlist: 'Playlist',
  podcast: 'Podcast',
  workshop: 'Workshop',
  mcp: 'MCP Server',
  skill: 'Skill',
  plugin: 'Plugin',
  tool: 'Tool',
  platform: 'Platform',
  'llm-model': 'LLM Model',
  example: 'Example',
  cli: 'CLI',
  'md-doc': 'MD Doc',
  other: 'Other',
};

// ── Helpers ───────────────────────────────────────────────────────────────────
const isNonEmptyString = (v: unknown): v is string =>
  typeof v === 'string' && v.length > 0;
const uniq = (vals: string[]) => Array.from(new Set(vals));

// ── Filter options ────────────────────────────────────────────────────────────
const humanResources = resourcesFallback.filter((r) =>
  HUMAN_TYPES.has(r.data.type),
);
const agentResources = resourcesFallback.filter((r) =>
  AGENT_TYPES.has(r.data.type),
);

const humanTypeOptions = uniq(humanResources.map((r) => r.data.type))
  .map((id) => ({ id, label: TYPE_LABELS[id] ?? id }))
  .sort((a, b) => a.label.localeCompare(b.label));

const agentTypeOptions = uniq(agentResources.map((r) => r.data.type))
  .map((id) => ({ id, label: TYPE_LABELS[id] ?? id }))
  .sort((a, b) => a.label.localeCompare(b.label));

const allTypeOptions = uniq(resourcesFallback.map((r) => r.data.type))
  .map((id) => ({ id, label: TYPE_LABELS[id] ?? id }))
  .sort((a, b) => a.label.localeCompare(b.label));

type ResourceLevel = 'intro' | 'intermediate' | 'advanced' | 'reference';
type ResourceStatus =
  | 'planned'
  | 'reading'
  | 'completed'
  | 'reference'
  | 'archived';

const levelOptions = uniq(
  resourcesFallback
    .map((r) => r.data.level)
    .filter((v): v is ResourceLevel => typeof v === 'string'),
)
  .map((id) => ({ id, label: id.charAt(0).toUpperCase() + id.slice(1) }))
  .sort((a, b) => a.label.localeCompare(b.label));

const statusOptions = uniq(
  resourcesFallback
    .map((r) => r.data.status)
    .filter((v): v is ResourceStatus => typeof v === 'string'),
)
  .map((id) => ({ id, label: id.charAt(0).toUpperCase() + id.slice(1) }))
  .sort((a, b) => a.label.localeCompare(b.label));

const tagOptions = uniq(resourcesFallback.flatMap((r) => r.data.tagIds ?? []))
  .map((id) => ({ id, label: tagTitleById.get(id) }))
  .filter(
    (o): o is { id: string; label: string } => typeof o.label === 'string',
  )
  .sort((a, b) => a.label.localeCompare(b.label));

const toolOptions = uniq(resourcesFallback.flatMap((r) => r.data.toolIds ?? []))
  .map((id) => ({ id, label: toolTitleById.get(id) }))
  .filter(
    (o): o is { id: string; label: string } => typeof o.label === 'string',
  )
  .sort((a, b) => a.label.localeCompare(b.label));

const categoryOptions = uniq(
  resourcesFallback.flatMap((r) => r.data.categoryIds ?? []),
)
  .map((id) => ({ id, label: categoryTitleById.get(id) }))
  .filter(
    (o): o is { id: string; label: string } => typeof o.label === 'string',
  )
  .sort((a, b) => a.label.localeCompare(b.label));

// ── Hero stats ────────────────────────────────────────────────────────────────
const totalResources = resourcesFallback.length;
const completedCount = resourcesFallback.filter(
  (r) => r.data.status === 'completed',
).length;

// ── Dashboard charts ──────────────────────────────────────────────────────────
const humanTypeCounts = new Map<string, number>();
for (const r of humanResources) {
  humanTypeCounts.set(r.data.type, (humanTypeCounts.get(r.data.type) ?? 0) + 1);
}
const humanChartLabels = [...humanTypeCounts.keys()].map(
  (k) => TYPE_LABELS[k] ?? k,
);
const humanChartValues = [...humanTypeCounts.values()];

const agentTypeCounts = new Map<string, number>();
for (const r of agentResources) {
  agentTypeCounts.set(r.data.type, (agentTypeCounts.get(r.data.type) ?? 0) + 1);
}
const agentChartLabels = [...agentTypeCounts.keys()].map(
  (k) => TYPE_LABELS[k] ?? k,
);
const agentChartValues = [...agentTypeCounts.values()];

const progressLabels = [
  'Completed',
  'Reading',
  'Planned',
  'Reference',
  'Archived',
];
const progressValues = progressLabels.map(
  (label) =>
    resourcesFallback.filter((r) => r.data.status === label.toLowerCase())
      .length,
);

// ── Card list (sorted alphabetically for stable pagination) ──────────────────
const humanSorted = humanResources
  .slice()
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const agentSorted = agentResources
  .slice()
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const allSorted = [...humanSorted, ...agentSorted];

// ── Graph nodes (minimal payload, capped for GPU budget) ─────────────────────
const graphNodes = allSorted.slice(0, 500).map((r) => ({
  id: r.data.resourceId,
  title: r.data.title.slice(0, 50),
  type: r.data.type,
  audience: deriveAudience(r.data.type),
  cats: r.data.categoryIds ?? [],
}));
const graphNodesJson = JSON.stringify(graphNodes);

// ── Per-card helper (builds taxonomy pill arrays) ────────────────────────────
const buildCardMeta = (resource: CollectionEntry<'knowledgeResources'>) => {
  const tags = (resource.data.tagIds ?? [])
    .map((id) => tagTitleById.get(id))
    .filter(isNonEmptyString)
    .map((label) => ({ label }));
  const categories = (resource.data.categoryIds ?? [])
    .map((id) => categoryTitleById.get(id))
    .filter(isNonEmptyString)
    .map((label) => ({ label }));
  const tools = (resource.data.toolIds ?? [])
    .map((id) => toolTitleById.get(id))
    .filter(isNonEmptyString)
    .map((label) => ({ label }));
  const skills = (resource.data.skillIds ?? [])
    .map((id) => skillTitleById.get(id))
    .filter(isNonEmptyString)
    .map((label) => ({ label }));
  const projects = (resource.data.projectIds ?? [])
    .map((id) => ({ id, title: projectTitleById.get(id) }))
    .filter(
      (p): p is { id: string; title: string } => typeof p.title === 'string',
    )
    .map((p) => ({ label: p.title, href: `/${lang}/portfolio/${p.id}` }));
  const caseStudies = (resource.data.caseStudyIds ?? [])
    .map((id) => caseStudyMetaById.get(id))
    .filter((m): m is { title: string; slug: string } =>
      Boolean(m?.title && m?.slug),
    )
    .map((m) => ({ label: m.title, href: `/${lang}/case-studies/${m.slug}` }));
  const blogLinks = (resource.data.blogSlugs ?? [])
    .filter((slug) => publishedBlogSlugs.has(slug))
    .map((slug) => ({ label: `Blog: ${slug}`, href: `/${lang}/blog/${slug}` }));
  const metaParts = [
    TYPE_LABELS[resource.data.type] ?? resource.data.type,
    resource.data.level
      ? resource.data.level.charAt(0).toUpperCase() +
        resource.data.level.slice(1)
      : undefined,
    resource.data.status
      ? resource.data.status.charAt(0).toUpperCase() +
        resource.data.status.slice(1)
      : undefined,
  ].filter(isNonEmptyString);
  return {
    tags,
    categories,
    tools,
    skills,
    projects,
    caseStudies,
    blogLinks,
    meta: metaParts.join(' · '),
  };
};
---

<BaseLayout {title} {description} lang={lang} useLangPrefix>
  <!-- ══════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════ -->
  <header class="kc-hero" data-kc-hero>
    <div class="kc-hero__inner">
      <div class="kc-hero__eyebrow ds-eyebrow">
        <span
          class="i-solar-notebook-bold-duotone align-middle mr-2"
          aria-hidden="true"></span>
        Knowledge Intelligence
      </div>
      <h1 class="kc-hero__title">Knowledge&nbsp;Center</h1>
      <p class="kc-hero__sub">{description}</p>

      {
        resources.length === 0 && lang !== 'en' ? (
          <p class="kc-fallback-note ds-label">
            Showing English resources while {lang.toUpperCase()} content is
            being authored.
          </p>
        ) : null
      }

      <!-- Stats ribbon -->
      <div class="kc-stats" role="list">
        {
          (
            [
              {
                icon: 'i-ph-books-duotone',
                label: 'Total',
                value: totalResources || '1k+',
              },
              {
                icon: 'i-ph-user-duotone',
                label: 'Human',
                value: humanResources.length || '—',
              },
              {
                icon: 'i-ph-robot-duotone',
                label: 'Agent',
                value: agentResources.length || '—',
              },
              {
                icon: 'i-ph-check-circle-duotone',
                label: 'Completed',
                value: completedCount || '—',
              },
            ] as const
          ).map(({ icon, label, value }) => (
            <div class="kc-stat" role="listitem">
              <span class={`${icon} kc-stat__icon`} aria-hidden="true" />
              <span class="kc-stat__value">{value}</span>
              <span class="kc-stat__label ds-label">{label}</span>
            </div>
          ))
        }
      </div>

      <!-- View toggle -->
      <div class="kc-view-toggle" role="group" aria-label="View mode">
        <button
          class="kc-view-btn"
          data-kc-view="dashboard"
          aria-pressed="true"
        >
          <span class="i-ph-squares-four-duotone" aria-hidden="true"></span>
          Dashboard
        </button>
        <button class="kc-view-btn" data-kc-view="graph" aria-pressed="false">
          <span class="i-ph-graph-duotone" aria-hidden="true"></span>
          Graph
        </button>
      </div>
    </div>

    <div class="kc-hero__grid ds-control-grid" aria-hidden="true"></div>
  </header>

  <!-- ══════════════════════════════════════════════════════
       OVERVIEW CHARTS (dashboard)
  ══════════════════════════════════════════════════════ -->
  <section
    class="kc-charts"
    aria-label="Resource overview"
    data-kc-section
    data-kc-panel="dashboard"
  >
    <!-- Human resources breakdown -->
    <div class="kc-dash-panel">
      <header class="kc-panel-header">
        <span
          class="i-ph-user-duotone kc-panel-icon text-[var(--color-cta)]"
          aria-hidden="true"></span>
        <div>
          <h2 class="kc-panel-title">Human Resources</h2>
          <p class="kc-panel-sub ds-label">
            {humanResources.length} resources · books, articles, courses…
          </p>
        </div>
      </header>
      {
        humanChartLabels.length > 0 ? (
          <LazyBarChart
            labels={humanChartLabels}
            values={humanChartValues}
            title="Human resource types"
            series="Resources"
            horizontal
            height={Math.max(120, humanChartLabels.length * 34 + 24)}
            class="kc-chart"
          />
        ) : (
          <p class="kc-empty">No human resources yet.</p>
        )
      }
    </div>

    <!-- Agent resources breakdown -->
    <div class="kc-dash-panel">
      <header class="kc-panel-header">
        <span
          class="i-ph-robot-duotone kc-panel-icon text-[var(--ds-color-security)]"
          aria-hidden="true"></span>
        <div>
          <h2 class="kc-panel-title">Agent Resources</h2>
          <p class="kc-panel-sub ds-label">
            {agentResources.length} resources · MCPs, skills, tools…
          </p>
        </div>
      </header>
      {
        agentChartLabels.length > 0 ? (
          <LazyBarChart
            labels={agentChartLabels}
            values={agentChartValues}
            title="Agent resource types"
            series="Resources"
            horizontal
            height={Math.max(120, agentChartLabels.length * 34 + 24)}
            class="kc-chart"
          />
        ) : (
          <p class="kc-empty">No agent resources yet.</p>
        )
      }
    </div>

    <!-- Reading progress -->
    <div class="kc-dash-panel kc-dash-panel--wide">
      <header class="kc-panel-header">
        <span
          class="i-solar-book-2-bold-duotone kc-panel-icon text-accent"
          aria-hidden="true"></span>
        <div>
          <h2 class="kc-panel-title">Reading Progress</h2>
          <p class="kc-panel-sub ds-label">
            {completedCount} completed of {totalResources}
          </p>
        </div>
      </header>
      <LazyBarChart
        labels={progressLabels}
        values={progressValues}
        title="Reading progress by status"
        series="Resources"
        horizontal
        height={progressLabels.length * 38 + 24}
        class="kc-chart"
      />
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════
       FILTER BAR (dashboard)
  ══════════════════════════════════════════════════════ -->
  <section
    class="kc-filter-section"
    data-kc-section
    data-kc-panel="dashboard"
    data-knowledge-filter
    data-target="#kc-items"
  >
    <form class="kc-filter-form">
      <fieldset class="kc-filter-fieldset">
        <legend class="kc-filter-legend">
          <span class="i-ph-funnel-duotone align-middle mr-1" aria-hidden="true"
          ></span>
          Filter
        </legend>
        <div class="kc-filter-grid">
          <div class="kc-filter-control">
            <label for="kc-f-audience">Audience</label>
            <select
              id="kc-f-audience"
              data-filter-audience
              data-kc-audience-sel
            >
              <option value="">All audiences</option>
              <option value="human">Human</option>
              <option value="agent">Agent</option>
            </select>
          </div>

          <div class="kc-filter-control">
            <label for="kc-f-type">Type</label>
            <select id="kc-f-type" data-filter-type>
              <option value="">All types</option>
              <optgroup label="Human" data-kc-optgroup="human">
                {
                  humanTypeOptions.map((o) => (
                    <option value={o.id}>{o.label}</option>
                  ))
                }
              </optgroup>
              <optgroup label="Agent" data-kc-optgroup="agent">
                {
                  agentTypeOptions.map((o) => (
                    <option value={o.id}>{o.label}</option>
                  ))
                }
              </optgroup>
            </select>
          </div>

          <div class="kc-filter-control">
            <label for="kc-f-status">Status</label>
            <select id="kc-f-status" data-filter-status>
              <option value="">All statuses</option>
              {
                statusOptions.map((o) => (
                  <option value={o.id}>{o.label}</option>
                ))
              }
            </select>
          </div>

          <div class="kc-filter-control">
            <label for="kc-f-level">Level</label>
            <select id="kc-f-level" data-filter-level>
              <option value="">All levels</option>
              {levelOptions.map((o) => <option value={o.id}>{o.label}</option>)}
            </select>
          </div>

          {
            categoryOptions.length > 0 && (
              <div class="kc-filter-control">
                <label for="kc-f-category">Domain</label>
                <select id="kc-f-category" data-filter-category>
                  <option value="">All domains</option>
                  {categoryOptions.map((o) => (
                    <option value={o.id}>{o.label}</option>
                  ))}
                </select>
              </div>
            )
          }

          {
            toolOptions.length > 0 && (
              <div class="kc-filter-control">
                <label for="kc-f-tool">Tool</label>
                <select id="kc-f-tool" data-filter-tool>
                  <option value="">All tools</option>
                  {toolOptions.map((o) => (
                    <option value={o.id}>{o.label}</option>
                  ))}
                </select>
              </div>
            )
          }

          {
            tagOptions.length > 0 && (
              <div class="kc-filter-control">
                <label for="kc-f-tag">Tag</label>
                <select id="kc-f-tag" data-filter-tag>
                  <option value="">All tags</option>
                  {tagOptions.map((o) => (
                    <option value={o.id}>{o.label}</option>
                  ))}
                </select>
              </div>
            )
          }
        </div>

        <div class="kc-filter-actions">
          <p class="kc-filter-count" data-filter-count aria-live="polite">
            {totalResources} resources
          </p>
          <div style="display:flex;gap:var(--space-2);align-items:center">
            <span class="kc-search-wrap">
              <span
                class="i-ph-magnifying-glass-duotone kc-search-icon"
                aria-hidden="true"></span>
              <input
                id="kc-search"
                type="search"
                placeholder="Search titles…"
                data-kc-search
                autocomplete="off"
                spellcheck="false"
              />
            </span>
            <button class="button" type="button" data-filter-reset>Reset</button
            >
          </div>
        </div>
      </fieldset>
    </form>
  </section>

  <!-- ══════════════════════════════════════════════════════
       CARD GRID (dashboard)
  ══════════════════════════════════════════════════════ -->
  <section class="kc-grid-section" data-kc-section data-kc-panel="dashboard">
    <!-- Pagination top -->
    <div class="kc-pagination" data-kc-pagination>
      <button
        class="kc-page-btn"
        data-kc-prev
        disabled
        aria-label="Previous page"
      >
        <span class="i-ph-caret-left-duotone" aria-hidden="true"></span>
        Prev
      </button>
      <span class="kc-page-info" data-kc-page-info aria-live="polite">
        Page 1 · {totalResources} resources
      </span>
      <button class="kc-page-btn" data-kc-next aria-label="Next page">
        Next
        <span class="i-ph-caret-right-duotone" aria-hidden="true"></span>
      </button>
    </div>

    <!-- Items container -->
    <div id="kc-items">
      <!-- ── Human resources ───────────────────────────────── -->
      <div
        class="kc-audience-section"
        data-knowledge-group
        data-audience-section="human"
      >
        <h2 class="kc-audience-title">
          <span class="i-ph-user-duotone kc-audience-icon" aria-hidden="true"
          ></span>
          Human Resources
          <span class="kc-audience-count ds-label">({humanSorted.length})</span>
        </h2>
        <div class="kc-cards">
          {
            humanSorted.map((resource) => {
              const href = `/${lang}/knowledge/${resource.data.resourceId}`;
              const {
                tags,
                categories,
                tools,
                skills,
                projects,
                caseStudies,
                blogLinks,
                meta,
              } = buildCardMeta(resource);
              return (
                <div
                  data-knowledge-item
                  data-audience="human"
                  data-type={resource.data.type}
                  data-level={resource.data.level ?? ''}
                  data-status={resource.data.status ?? ''}
                  data-tag-ids={(resource.data.tagIds ?? []).join(' ')}
                  data-tool-ids={(resource.data.toolIds ?? []).join(' ')}
                  data-category-ids={(resource.data.categoryIds ?? []).join(
                    ' ',
                  )}
                >
                  <ContentCard
                    title={resource.data.title}
                    href={href}
                    summary={resource.data.summary}
                    meta={meta}
                  >
                    {resource.data.url ? (
                      <p>
                        <a
                          href={resource.data.url}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          Open resource ↗
                        </a>
                      </p>
                    ) : null}
                    {tools.length > 0 ? (
                      <TaxonomyPills label="Tools" items={tools} />
                    ) : null}
                    {skills.length > 0 ? (
                      <TaxonomyPills label="Skills" items={skills} />
                    ) : null}
                    {categories.length > 0 ? (
                      <TaxonomyPills label="Domains" items={categories} />
                    ) : null}
                    {tags.length > 0 ? (
                      <TaxonomyPills label="Tags" items={tags} />
                    ) : null}
                    {projects.length > 0 ? (
                      <TaxonomyPills
                        label="Related projects"
                        items={projects}
                      />
                    ) : null}
                    {caseStudies.length > 0 ? (
                      <TaxonomyPills label="Case studies" items={caseStudies} />
                    ) : null}
                    {blogLinks.length > 0 ? (
                      <TaxonomyPills label="Blog posts" items={blogLinks} />
                    ) : null}
                  </ContentCard>
