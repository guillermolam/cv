<!-- ══════════════════════════════════════════════════════
     CLIENT SCRIPT
══════════════════════════════════════════════════════ -->
<script>
  import { initKnowledgeFilters } from '../../../scripts/content-filters';

  const PAGE_SIZE = 50;
  let currentPage = 0;

  // ── View toggle ─────────────────────────────────────────────────────────────
  const allPanels = document.querySelectorAll<HTMLElement>('[data-kc-panel]');
  const viewBtns =
    document.querySelectorAll<HTMLButtonElement>('[data-kc-view]');

  const switchView = (view: string) => {
    allPanels.forEach((p) => {
      const isMatch = p.dataset.kcPanel === view;
      p.hidden = !isMatch;
      p.toggleAttribute('hidden', !isMatch);
    });
    viewBtns.forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.kcView === view)),
    );
    if (view === 'graph') void lazyInitGraph();
  };

  viewBtns.forEach((b) =>
    b.addEventListener('click', () =>
      switchView(b.dataset.kcView ?? 'dashboard'),
    ),
  );

  // Initial state — ensure dashboard panels are visible
  allPanels.forEach((p) => {
    if (p.dataset.kcPanel === 'graph') p.hidden = true;
    else p.hidden = false;
  });

  // ── Audience-aware type optgroup filter ──────────────────────────────────────
  // When audience select changes, grey out optgroups that don't belong
  const audienceSel = document.querySelector<HTMLSelectElement>(
    '[data-kc-audience-sel]',
  );
  const typeSel =
    document.querySelector<HTMLSelectElement>('[data-filter-type]');

  audienceSel?.addEventListener('change', () => {
    const aud = audienceSel.value;
    if (!typeSel) return;
    // Reset type if current selection is in wrong audience
    const selectedOpt = typeSel.querySelector<HTMLOptionElement>(
      `option[value="${typeSel.value}"]`,
    );
    const optGroup = selectedOpt?.closest<HTMLOptGroupElement>('optgroup');
    if (aud && optGroup && optGroup.dataset.kcOptgroup !== aud) {
      typeSel.value = '';
    }
  });

  // ── Filter + search integration ─────────────────────────────────────────────
  initKnowledgeFilters();

  const filterRoot = document.querySelector<HTMLElement>(
    '[data-knowledge-filter]',
  );
  const searchInput =
    document.querySelector<HTMLInputElement>('[data-kc-search]');
  const allItems = Array.from(
    document.querySelectorAll<HTMLElement>('[data-knowledge-item]'),
  );
  const groupEls = Array.from(
    document.querySelectorAll<HTMLElement>('[data-knowledge-group]'),
  );

  // Search: hide items whose title doesn't match query
  const applySearch = (query: string) => {
    const q = query.trim().toLowerCase();
    if (!q) {
      allItems.forEach((el) => el.removeAttribute('data-kc-search-hide'));
      return;
    }
    allItems.forEach((el) => {
      const title =
        el
          .querySelector<HTMLElement>('[class*="card"]')
          ?.textContent?.toLowerCase() ?? '';
      el.toggleAttribute('data-kc-search-hide', !title.includes(q));
    });
  };

  // Pagination: runs AFTER filter + search are applied
  const applyPagination = () => {
    // Visible = passes filter (not hidden by initKnowledgeFilters) AND passes search
    const visible = allItems.filter(
      (el) => !el.hidden && !el.hasAttribute('data-kc-search-hide'),
    );
    const totalPages = Math.max(1, Math.ceil(visible.length / PAGE_SIZE));
    currentPage = Math.min(currentPage, totalPages - 1);

    const start = currentPage * PAGE_SIZE;
    const pageSet = new Set(visible.slice(start, start + PAGE_SIZE));

    // Show only page items; respect existing filter state for others
    visible.forEach((el) => {
      el.hidden = !pageSet.has(el);
    });

    // Sync pagination controls
    const label = `Page ${currentPage + 1} of ${totalPages} · ${visible.length} resources`;
    document
      .querySelectorAll('[data-kc-page-info],[data-kc-page-info-b]')
      .forEach((el) => {
        el.textContent = label;
      });
    document
      .querySelectorAll<HTMLButtonElement>('[data-kc-prev],[data-kc-prev-b]')
      .forEach((b) => {
        b.disabled = currentPage === 0;
      });
    document
      .querySelectorAll<HTMLButtonElement>('[data-kc-next],[data-kc-next-b]')
      .forEach((b) => {
        b.disabled = currentPage >= totalPages - 1;
      });

    // Hide audience section headers if no visible items within them
    groupEls.forEach((g) => {
      const hasVisible = allItems.some(
        (el) => el.closest('[data-audience-section]') === g && !el.hidden,
      );
      g.hidden = !hasVisible;
    });
  };

  // Wire up: after filter changes, reset page and re-paginate
  const onFilterChange = () => {
    currentPage = 0;
    // Let initKnowledgeFilters apply first (it runs synchronously via change events)
    requestAnimationFrame(applyPagination);
  };

  document.querySelectorAll('[data-knowledge-filter] select').forEach((sel) => {
    sel.addEventListener('change', onFilterChange);
  });
  document
    .querySelector('[data-filter-reset]')
    ?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      allItems.forEach((el) => el.removeAttribute('data-kc-search-hide'));
      currentPage = 0;
      requestAnimationFrame(applyPagination);
    });

  searchInput?.addEventListener('input', () => {
    applySearch(searchInput.value);
    currentPage = 0;
    requestAnimationFrame(applyPagination);
  });

  // Pagination button handlers
  const goToPage = (delta: number) => {
    currentPage += delta;
    applyPagination();
    document
      .querySelector('[data-kc-pagination]')
      ?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };
  document
    .querySelectorAll('[data-kc-prev],[data-kc-prev-b]')
    .forEach((b) => b.addEventListener('click', () => goToPage(-1)));
  document
    .querySelectorAll('[data-kc-next],[data-kc-next-b]')
    .forEach((b) => b.addEventListener('click', () => goToPage(+1)));

  // Initial paginate
  requestAnimationFrame(applyPagination);

  // ── Graph lazy-init ──────────────────────────────────────────────────────────
  let graphDispose: (() => void) | null = null;
  let graphInited = false;

  async function lazyInitGraph() {
    if (graphInited) return;
    graphInited = true;
    const { initKnowledgeGraph } =
      await import('../../../scripts/knowledge-graph');
    const canvas = document.getElementById(
      'kc-graph-canvas',
    ) as HTMLCanvasElement | null;
    const tooltip = document.querySelector<HTMLElement>('[data-kc-tooltip]');
    const nodesEl = document.getElementById('kc-graph-nodes');
    const nodes = nodesEl ? JSON.parse(nodesEl.textContent ?? '[]') : [];
    if (canvas) graphDispose = initKnowledgeGraph(canvas, nodes, tooltip);
  }

  // Dispose graph on page navigation
  document.addEventListener(
    'astro:before-swap',
    () => {
      graphDispose?.();
      graphDispose = null;
      graphInited = false;
    },
    { once: true },
  );

  // ── GSAP scroll animations ────────────────────────────────────────────────────
  import { prefersReducedMotion } from '../../../design-system/motion/reduced-motion';

  if (!prefersReducedMotion()) {
    const { gsap } = await import('../../../lib/gsap-plugins');
    const { ScrollTrigger } = await import('gsap/ScrollTrigger');
    gsap.registerPlugin(ScrollTrigger);

    const hero = document.querySelector('[data-kc-hero] .kc-hero__inner');
    if (hero)
      gsap.from(hero, {
        y: 28,
        opacity: 0,
        duration: 0.9,
        ease: 'ds.cinematicReveal',
      });

    document
      .querySelectorAll<HTMLElement>('[data-kc-section]')
      .forEach((section) => {
        gsap.from(section, {
          scrollTrigger: { trigger: section, start: 'top 88%', once: true },
          y: 24,
          opacity: 0,
          duration: 0.65,
          ease: 'ds.softOut',
        });
      });
  }
</script>

