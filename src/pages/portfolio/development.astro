---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Portfolio · Development';
const description = 'Development projects and software work highlights.';
---

<BaseLayout title={title} description={description}>
  <section class="card pad">
    <h1>Development</h1>
    <p>Selected development work will be published here.</p>
    <div class="cta-row">
      <a class="button" href="/portfolio">Back to portfolio</a>
      <a class="button primary" href="/cv">Download CV</a>
    </div>
  </section>
</BaseLayout>

