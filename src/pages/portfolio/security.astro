---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Portfolio · Security';
const description = 'Security and DevSecOps projects and work highlights.';
---

<BaseLayout title={title} description={description}>
  <section class="card pad">
    <h1>Security</h1>
    <p>Selected security and DevSecOps work will be published here.</p>
    <div class="cta-row">
      <a class="button" href="/portfolio">Back to portfolio</a>
      <a class="button primary" href="/cv">Download CV</a>
    </div>
  </section>
</BaseLayout>

