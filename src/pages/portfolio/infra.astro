---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Portfolio · Infrastructure';
const description = 'Infrastructure and platform engineering work highlights.';
---

<BaseLayout title={title} description={description}>
  <section class="card pad">
    <h1>Infrastructure</h1>
    <p>Selected infrastructure and platform work will be published here.</p>
    <div class="cta-row">
      <a class="button" href="/portfolio">Back to portfolio</a>
      <a class="button primary" href="/cv">Download CV</a>
    </div>
  </section>
</BaseLayout>

