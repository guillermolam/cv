---
import GlbModelViewer from '../../components/GlbModelViewer.astro';
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout
  title="Model Viewer Test"
  description="Temporary page to validate model-viewer can load /3d/guillermolam-avatar.glb and report status."
>
  <h1>Model Viewer Test: /3d/guillermolam-avatar.glb</h1>
  <p class="muted">
    This is a temporary diagnostic page. It does not use Three.js; it uses the
    existing
    <code>&lt;model-viewer&gt;</code> progressive enhancement.
  </p>

  <section class="card pad status-card" aria-label="Model load status">
    <h2>Status</h2>
    <p id="mv-status" role="status" aria-live="polite">Initializing…</p>
    <p class="muted">
      Open DevTools Console and look for logs prefixed with <code
        >[model-meshy-test]</code
      >.
    </p>
  </section>

  <GlbModelViewer
    class="js-model-meshy-test"
    src={import.meta.env.BASE_URL.replace(/\/$/, '') +
      '/3d/guillermolam-avatar.glb'}
    reveal="auto"
    title="Guillermo Lam avatar (3D)"
    description="Attempts to load /3d/guillermolam-avatar.glb via model-viewer and reports load success/failure."
  />

  <script>
    (async () => {
      const statusEl = document.getElementById('mv-status');

      const setStatus = (text: string) => {
        if (!statusEl) return;
        statusEl.textContent = text;
      };

      const info = (...args: unknown[]) =>
        console.info('[model-meshy-test]', ...args);
      const error = (...args: unknown[]) =>
        console.error('[model-meshy-test]', ...args);

      setStatus('Loading model-viewer web component…');

      try {
        const timeoutMs = 4_000;
        await Promise.race([
          customElements.whenDefined('model-viewer'),
          new Promise<void>((_, reject) =>
            window.setTimeout(
              () => reject(new Error(`Timed out after ${timeoutMs}ms`)),
              timeoutMs,
            ),
          ),
        ]);
      } catch (e) {
        setStatus(
          'Failed: model-viewer web component did not load (see console).',
        );
        error('model-viewer was not defined in time', e);
        return;
      }

      const viewer = document.querySelector(
        '.js-model-meshy-test model-viewer',
      ) as HTMLElement | null;
      if (!viewer) {
        setStatus('Failed: <model-viewer> element not found in DOM.');
        error('Expected element selector: .js-model-meshy-test model-viewer');
        return;
      }

      const src = viewer.getAttribute('src');
      info('Viewer element found', { src });

      let terminalState: 'loading' | 'loaded' | 'failed' = 'loading';
      const markTerminal = (state: typeof terminalState, message: string) => {
        if (terminalState === 'loaded' || terminalState === 'failed') return;
        terminalState = state;
        setStatus(message);
      };

      setStatus('Loading model asset…');

      viewer.addEventListener(
        'load',
        () => {
          markTerminal(
            'loaded',
            'Loaded: model-viewer rendered the model successfully.',
          );
          info('load event fired');
        },
        { once: true },
      );

      viewer.addEventListener(
        'error',
        (event) => {
          markTerminal(
            'failed',
            'Failed: model-viewer could not load/render the model (see console).',
          );
          error('error event fired', event);
        },
        { once: true },
      );

      // Best-effort progress reporting (the event payload shape can vary by model-viewer version).
      viewer.addEventListener('progress', (event: Event) => {
        if (terminalState !== 'loading') return;
        const typedEvent = event as CustomEvent<{ totalProgress?: number }>;
        const total = typedEvent.detail?.totalProgress;
        if (typeof total !== 'number' || Number.isNaN(total)) return;
        const percent = Math.round(total * 100);
        if (percent >= 0 && percent < 100)
          setStatus(`Loading model asset… ${percent}%`);
      });

      // If neither event fires (bad format / fetch blocked / unsupported), make the failure obvious.
      window.setTimeout(() => {
        if (terminalState !== 'loading') return;
        terminalState = 'failed';
        setStatus(
          'Failed: no load/error signal after 10s (see console + Network tab).',
        );
        error('Timed out waiting for load/error', { src });
      }, 10_000);
    })();
  </script>

  <style>
    .muted {
      color: var(--color-text-muted);
    }

    .status-card {
      margin: 1.25rem 0;
    }

    code {
      font-family:
        ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
        'Liberation Mono', 'Courier New', monospace;
      font-size: 0.95em;
    }
  </style>
</PageLayout>
