{
  "name": "astro-threejs-portfolio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-dev-singleton.mjs --host 0.0.0.0 --port 4321",
    "dev:4324": "node scripts/run-dev-singleton.mjs --host 0.0.0.0 --port 4324",
    "image:3d": "node scripts/image-to-3d.mjs",
    "image:svg": "node scripts/image-to-3d.mjs --workflow svg --svg-provider local --svg-model qwen2.5vl:3b",
    "image:raster": "node scripts/image-to-3d.mjs --workflow raster --image-provider ollama --image-model x/z-image-turbo:fp8",
    "image:raster-to-svg": "node scripts/image-to-3d.mjs --workflow raster-to-svg --image-provider ollama --image-model x/z-image-turbo:fp8 --svg-provider local --svg-model qwen2.5vl:3b",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "preview:4324": "astro preview --host 0.0.0.0 --port 4324",
    "check": "astro check",
    "deps:forbidden": "node scripts/scan-forbidden-design-library.mjs",
    "motion:validate": "node scripts/validate-motion-foundation.mjs",
    "layout:validate": "node scripts/validate-layout-navigation.mjs",
    "data-display:validate": "node scripts/validate-data-display.mjs",
    "retro:validate": "node scripts/validate-retro-aesthetic.mjs",
    "charts:validate": "node scripts/validate-charts.mjs",
    "content:validate": "node scripts/validate-content-graph.mjs",
    "content:graph": "node scripts/generate-content-graph.mjs",
    "neural:graph": "node scripts/generate-neural-graph.mjs",
    "vault:import": "node scripts/import-bookmarks-to-vault.mjs",
    "gmail-signature:build": "node scripts/build-gmail-signature.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.1",
    "@google/model-viewer": "^4.3.1",
    "@types/alpinejs": "^3.13.11",
    "alpinejs": "^3.17.2",
    "apexcharts": "7.3.0",
    "astro": "^7.3.2",
    "chart.js": "4.5.1",
    "d3": "^7.9.0",
    "geojson": "^0.5.0",
    "gsap": "^3.15.0",
    "heerich": "^0.16.0",
    "nanostores": "1.5.3",
    "three": "0.186.0",
    "topojson-client": "^3.1.0",
    "typescript": "6.0.3",
    "world-atlas": "^2.0.2"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,astro,json,md,yaml,yml,css}": "prettier --write",
    ".github/workflows/*.{yml,yaml}": "zizmor"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.5",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/solar": "^1.2.10",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify/utils": "^3.1.7",
    "@playwright/test": "^1.63.0",
    "@types/d3": "7.4.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.5.1",
    "@types/three": "~0.186.0",
    "@types/topojson-client": "3.1.5",
    "@unocss/astro": "66.10.2",
    "@unocss/preset-mini": "66.10.2",
    "astro-icon": "^1.2.0",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "pixi.js": "8.20.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "unocss": "66.10.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
