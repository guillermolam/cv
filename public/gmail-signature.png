<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Guillermo Lam Martin — Gmail Signature Dynamic Panels</title>
</head>
<body style="margin:0;padding:24px;background:#ffffff;">

<table role="presentation" cellpadding="0" cellspacing="0" border="0"
       style="font-family:Arial,Helvetica,sans-serif;border-collapse:separate;border-spacing:0;
              width:790px;max-width:790px;color:#101828;background:#ffffff;
              border:1px solid #e4e7ec;border-radius:18px;">
  <tr>
    <!-- LEFT IDENTITY PANEL -->
    <td valign="top" width="210"
        style="width:210px;padding:18px 16px 16px 18px;background:#f8fafc;
               border-right:1px solid #e4e7ec;border-radius:18px 0 0 18px;">

      <!-- Portrait overlaps its panel visually without absolute positioning -->
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
          <td align="center" style="padding-bottom:12px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                   style="border-collapse:separate;border-spacing:0;background:#ffffff;
                          border:1px solid #d0d5dd;border-radius:16px;">
              <tr>
                <td style="padding:5px;">
                  <img src="data:image/png;base64," width="148" height="148" alt="Guillermo Lam Martin"
                       style="display:block;width:148px;height:148px;object-fit:cover;
                              border-radius:12px;background:#eef2f6;">
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>

      <!-- Contact panel -->
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
             style="border-collapse:separate;border-spacing:0;background:#ffffff;
                    border:1px solid #e4e7ec;border-radius:12px;">
        <tr>
          <td style="padding:9px 10px 7px 10px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
                   style="font-size:11px;line-height:16px;">
              <tr>
                <td width="24" style="padding:4px 7px 4px 0;">
                  <img src="data:image/png;base64," width="20" height="20" alt="" style="display:block;">
                </td>
                <td style="padding:4px 0;">
                  <a href="mailto:guillermolam.m@gmail.com" style="color:#101828;text-decoration:none;">guillermolam.m@gmail.com</a>
                </td>
              </tr>
              <tr><td colspan="2" style="border-top:1px solid #eef2f6;"></td></tr>
              <tr>
                <td style="padding:4px 7px 4px 0;">
                  <img src="data:image/png;base64," width="20" height="20" alt="" style="display:block;">
                </td>
                <td style="padding:4px 0;">
                  <a href="https://github.com/guillermolam" style="color:#101828;text-decoration:none;">github.com/guillermolam</a>
                </td>
              </tr>
              <tr><td colspan="2" style="border-top:1px solid #eef2f6;"></td></tr>
              <tr>
                <td style="padding:4px 7px 4px 0;">
                  <img src="data:image/png;base64," width="20" height="20" alt="" style="display:block;">
                </td>
                <td style="padding:4px 0;">
                  <a href="https://guillermolam.github.io/cv/" style="color:#101828;text-decoration:none;">guillermolam.github.io/cv/</a>
                </td>
              </tr>
              <tr><td colspan="2" style="border-top:1px solid #eef2f6;"></td></tr>
              <tr>
                <td style="padding:4px 7px 4px 0;">
                  <img src="data:image/png;base64," width="20" height="20" alt="" style="display:block;">
                </td>
                <td style="padding:4px 0;">
                  <a href="tel:+34620235950" style="color:#101828;text-decoration:none;">(+34) 620 23 59 50</a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>

    <!-- RIGHT MAIN PANEL -->
    <td valign="top" style="padding:16px 18px 14px 18px;">

      <!-- Header panel -->
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
             style="border-collapse:separate;border-spacing:0;background:#ffffff;
                    border:1px solid #e4e7ec;border-radius:14px;">
        <tr>
          <td style="padding:14px 16px 12px 16px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
              <tr>
                <td valign="top">
                  <div style="font-size:27px;line-height:29px;font-weight:800;letter-spacing:.3px;color:#0f172a;">
                    GUILLERMO
                  </div>
                  <div style="font-size:27px;line-height:29px;font-weight:800;letter-spacing:.3px;color:#2563eb;">
                    LAM MARTIN
                  </div>
                </td>
                <td valign="top" align="right" width="86" style="padding-top:1px;">
                  <img src="data:image/png;base64," width="78" alt="GL"
                       style="display:block;width:78px;height:auto;margin-left:auto;">
                </td>
              </tr>
            </table>

            <div style="width:44px;border-top:2px solid #2563eb;margin:9px 0 8px 0;"></div>

            <div style="font-size:13px;line-height:18px;font-weight:700;color:#101828;text-align:justify;">
              DevSecOps Engineer <span style="color:#2563eb;">|</span>
              Platform Engineering <span style="color:#2563eb;">|</span> SRE
            </div>
            <div style="font-size:13px;line-height:18px;font-weight:700;color:#101828;text-align:justify;">
              Cybersecurity <span style="color:#2563eb;">|</span>
              Purple Team <span style="color:#2563eb;">|</span> AI Security
            </div>
          </td>
        </tr>
      </table>

      <!-- Capability cards, aligned -->
      <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
             style="margin-top:10px;border-collapse:separate;border-spacing:0 7px;">
        <tr>
          <td valign="top" width="48" style="padding:7px 8px 7px 10px;background:#f8fafc;border-radius:11px 0 0 11px;">
            <img src="data:image/png;base64," width="30" height="30" alt="" style="display:block;">
          </td>
          <td valign="middle" style="padding:7px 11px;background:#f8fafc;border-radius:0 11px 11px 0;
                                     font-size:11.6px;line-height:16px;color:#344054;text-align:justify;">
            Software craftsmanship, scalable,
            <span style="color:#2563eb;">data-intensive resilient</span> architectures.
          </td>
        </tr>
        <tr>
          <td valign="top" style="padding:7px 8px 7px 10px;background:#ffffff;border:1px solid #eef2f6;
                                  border-right:0;border-radius:11px 0 0 11px;">
            <img src="data:image/png;base64," width="30" height="30" alt="" style="display:block;">
          </td>
          <td valign="middle" style="padding:7px 11px;background:#ffffff;border:1px solid #eef2f6;
                                     border-left:0;border-radius:0 11px 11px 0;
                                     font-size:11.6px;line-height:16px;color:#344054;text-align:justify;">
            Risk-compliant, <span style="color:#2563eb;">cloud-native</span>, agentic and generative
            <span style="color:#2563eb;">identity-aware</span> solutions.
          </td>
        </tr>
        <tr>
          <td valign="top" style="padding:7px 8px 7px 10px;background:#f8fafc;border-radius:11px 0 0 11px;">
            <img src="data:image/png;base64," width="30" height="30" alt="" style="display:block;">
          </td>
          <td valign="middle" style="padding:7px 11px;background:#f8fafc;border-radius:0 11px 11px 0;
                                     font-size:11.6px;line-height:16px;color:#344054;text-align:justify;">
            Shift-L Platforms, Systems design, making entropy
            <span style="color:#2563eb;">collaborative</span> and
            <span style="color:#2563eb;">deterministic</span>.
          </td>
        </tr>
        <tr>
          <td valign="top" style="padding:7px 8px 7px 10px;background:#ffffff;border:1px solid #eef2f6;
                                  border-right:0;border-radius:11px 0 0 11px;">
            <img src="data:image/png;base64," width="30" height="30" alt="" style="display:block;">
          </td>
          <td valign="middle" style="padding:7px 11px;background:#ffffff;border:1px solid #eef2f6;
                                     border-left:0;border-radius:0 11px 11px 0;
                                     font-size:11.6px;line-height:16px;color:#344054;text-align:justify;">
            Risk Threat Vulnerabilities Weaknesses →
            <span style="color:#d92d20;font-weight:700;">Red</span>,
            <span style="color:#7f56d9;font-weight:700;">Purple</span>,
            <span style="color:#175cd3;font-weight:700;">Blue</span>
            → <span style="color:#039855;font-weight:700;">Business Success</span>
          </td>
        </tr>
      </table>

    </td>
  </tr>
</table>

</body>
</html>